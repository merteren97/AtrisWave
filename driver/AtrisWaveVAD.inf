;
; AtrisWaveVAD.inf
; AtrisWave Virtual Audio Driver (PortCls WaveRT — 16-Slot Dynamic Pool)
; Windows 10/11 (x64 & ARM64)
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = AtrisWaveVAD.cat
DriverVer   = 11/27/2026,0.2.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13 ; Driver Store

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
AtrisWaveVAD.sys = 1,,

[Manufacturer]
%ManufacturerName% = AtrisWaveVAD_Models, NTamd64.10.0...22000, NTarm64.10.0...22000, NTamd64, NTarm64

[AtrisWaveVAD_Models.NTamd64.10.0...22000]
%DeviceDesc% = AtrisWaveVAD_Device, ROOT\AtrisWaveVAD

[AtrisWaveVAD_Models.NTarm64.10.0...22000]
%DeviceDesc% = AtrisWaveVAD_Device, ROOT\AtrisWaveVAD

[AtrisWaveVAD_Models.NTamd64]
%DeviceDesc% = AtrisWaveVAD_Device, ROOT\AtrisWaveVAD

[AtrisWaveVAD_Models.NTarm64]
%DeviceDesc% = AtrisWaveVAD_Device, ROOT\AtrisWaveVAD

[AtrisWaveVAD_Device.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = AtrisWaveVAD_CopyFiles
AddReg    = AtrisWaveVAD_AddReg

[AtrisWaveVAD_CopyFiles]
AtrisWaveVAD.sys

[AtrisWaveVAD_AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,AtrisWaveVAD.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%

[AtrisWaveVAD_Device.NT.Interfaces]
; 16 Paired WaveRT + Topology Interfaces (Friendly Names shown in Windows Sound / Discord / OBS)
AddInterface = %KSCATEGORY_AUDIO%,    "WaveSystem",    IF_System
AddInterface = %KSCATEGORY_RENDER%,   "WaveSystem",    IF_System
AddInterface = %KSCATEGORY_REALTIME%, "WaveSystem",    IF_System
AddInterface = %KSCATEGORY_AUDIO%,    "TopoSystem",    IF_System
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoSystem",    IF_System

AddInterface = %KSCATEGORY_AUDIO%,    "WaveMic",       IF_Mic
AddInterface = %KSCATEGORY_CAPTURE%,  "WaveMic",       IF_Mic
AddInterface = %KSCATEGORY_REALTIME%, "WaveMic",       IF_Mic
AddInterface = %KSCATEGORY_AUDIO%,    "TopoMic",       IF_Mic
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoMic",       IF_Mic

AddInterface = %KSCATEGORY_AUDIO%,    "WaveStreamMix", IF_StreamMix
AddInterface = %KSCATEGORY_CAPTURE%,  "WaveStreamMix", IF_StreamMix
AddInterface = %KSCATEGORY_REALTIME%, "WaveStreamMix", IF_StreamMix
AddInterface = %KSCATEGORY_AUDIO%,    "TopoStreamMix", IF_StreamMix
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoStreamMix", IF_StreamMix

AddInterface = %KSCATEGORY_AUDIO%,    "WaveGame",      IF_Game
AddInterface = %KSCATEGORY_RENDER%,   "WaveGame",      IF_Game
AddInterface = %KSCATEGORY_REALTIME%, "WaveGame",      IF_Game
AddInterface = %KSCATEGORY_AUDIO%,    "TopoGame",      IF_Game
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoGame",      IF_Game

AddInterface = %KSCATEGORY_AUDIO%,    "WaveChat",      IF_Chat
AddInterface = %KSCATEGORY_RENDER%,   "WaveChat",      IF_Chat
AddInterface = %KSCATEGORY_REALTIME%, "WaveChat",      IF_Chat
AddInterface = %KSCATEGORY_AUDIO%,    "TopoChat",      IF_Chat
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoChat",      IF_Chat

AddInterface = %KSCATEGORY_AUDIO%,    "WaveMedia",     IF_Media
AddInterface = %KSCATEGORY_RENDER%,   "WaveMedia",     IF_Media
AddInterface = %KSCATEGORY_REALTIME%, "WaveMedia",     IF_Media
AddInterface = %KSCATEGORY_AUDIO%,    "TopoMedia",     IF_Media
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoMedia",     IF_Media

AddInterface = %KSCATEGORY_AUDIO%,    "WaveAux",       IF_Aux
AddInterface = %KSCATEGORY_RENDER%,   "WaveAux",       IF_Aux
AddInterface = %KSCATEGORY_REALTIME%, "WaveAux",       IF_Aux
AddInterface = %KSCATEGORY_AUDIO%,    "TopoAux",       IF_Aux
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoAux",       IF_Aux

AddInterface = %KSCATEGORY_AUDIO%,    "WaveCh8",       IF_Ch8
AddInterface = %KSCATEGORY_RENDER%,   "WaveCh8",       IF_Ch8
AddInterface = %KSCATEGORY_REALTIME%, "WaveCh8",       IF_Ch8
AddInterface = %KSCATEGORY_AUDIO%,    "TopoCh8",       IF_Ch8
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoCh8",       IF_Ch8

AddInterface = %KSCATEGORY_AUDIO%,    "WaveCh9",       IF_Ch9
AddInterface = %KSCATEGORY_RENDER%,   "WaveCh9",       IF_Ch9
AddInterface = %KSCATEGORY_REALTIME%, "WaveCh9",       IF_Ch9
AddInterface = %KSCATEGORY_AUDIO%,    "TopoCh9",       IF_Ch9
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoCh9",       IF_Ch9

AddInterface = %KSCATEGORY_AUDIO%,    "WaveCh10",      IF_Ch10
AddInterface = %KSCATEGORY_RENDER%,   "WaveCh10",      IF_Ch10
AddInterface = %KSCATEGORY_REALTIME%, "WaveCh10",      IF_Ch10
AddInterface = %KSCATEGORY_AUDIO%,    "TopoCh10",      IF_Ch10
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoCh10",      IF_Ch10

AddInterface = %KSCATEGORY_AUDIO%,    "WaveCh11",      IF_Ch11
AddInterface = %KSCATEGORY_RENDER%,   "WaveCh11",      IF_Ch11
AddInterface = %KSCATEGORY_REALTIME%, "WaveCh11",      IF_Ch11
AddInterface = %KSCATEGORY_AUDIO%,    "TopoCh11",      IF_Ch11
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoCh11",      IF_Ch11

AddInterface = %KSCATEGORY_AUDIO%,    "WaveCh12",      IF_Ch12
AddInterface = %KSCATEGORY_RENDER%,   "WaveCh12",      IF_Ch12
AddInterface = %KSCATEGORY_REALTIME%, "WaveCh12",      IF_Ch12
AddInterface = %KSCATEGORY_AUDIO%,    "TopoCh12",      IF_Ch12
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoCh12",      IF_Ch12

AddInterface = %KSCATEGORY_AUDIO%,    "WaveCh13",      IF_Ch13
AddInterface = %KSCATEGORY_RENDER%,   "WaveCh13",      IF_Ch13
AddInterface = %KSCATEGORY_REALTIME%, "WaveCh13",      IF_Ch13
AddInterface = %KSCATEGORY_AUDIO%,    "TopoCh13",      IF_Ch13
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoCh13",      IF_Ch13

AddInterface = %KSCATEGORY_AUDIO%,    "WaveCh14",      IF_Ch14
AddInterface = %KSCATEGORY_RENDER%,   "WaveCh14",      IF_Ch14
AddInterface = %KSCATEGORY_REALTIME%, "WaveCh14",      IF_Ch14
AddInterface = %KSCATEGORY_AUDIO%,    "TopoCh14",      IF_Ch14
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoCh14",      IF_Ch14

AddInterface = %KSCATEGORY_AUDIO%,    "WaveCh15",      IF_Ch15
AddInterface = %KSCATEGORY_RENDER%,   "WaveCh15",      IF_Ch15
AddInterface = %KSCATEGORY_REALTIME%, "WaveCh15",      IF_Ch15
AddInterface = %KSCATEGORY_AUDIO%,    "TopoCh15",      IF_Ch15
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoCh15",      IF_Ch15

AddInterface = %KSCATEGORY_AUDIO%,    "WaveCh16",      IF_Ch16
AddInterface = %KSCATEGORY_RENDER%,   "WaveCh16",      IF_Ch16
AddInterface = %KSCATEGORY_REALTIME%, "WaveCh16",      IF_Ch16
AddInterface = %KSCATEGORY_AUDIO%,    "TopoCh16",      IF_Ch16
AddInterface = %KSCATEGORY_TOPOLOGY%, "TopoCh16",      IF_Ch16

[IF_System]
AddReg = IF_System_Reg
[IF_System_Reg]
HKR,,FriendlyName,,%EndpointSystem%
HKR,,CLSID,,%Proxy.CLSID%

[IF_Mic]
AddReg = IF_Mic_Reg
[IF_Mic_Reg]
HKR,,FriendlyName,,%EndpointMic%
HKR,,CLSID,,%Proxy.CLSID%

