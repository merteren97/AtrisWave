[AtrisWaveVAD_Device.NT.Services]
AddService = AtrisWaveVAD, 0x00000002, AtrisWaveVAD_Service_Inst

[AtrisWaveVAD_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\AtrisWaveVAD.sys

[AtrisWaveVAD_Device.NT.Wdf]
KmdfService = AtrisWaveVAD, AtrisWaveVAD_wdfsect

[AtrisWaveVAD_wdfsect]
KmdfLibraryVersion = 1.33

