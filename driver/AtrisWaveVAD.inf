;
; AtrisWaveVAD.inf
; AtrisWave Virtual Audio Driver (KMDF 1.33 / ACX + WaveRT)
; 16-Slot Pre-Provisioned Dynamic Pool for Windows 10/11 (x64 & ARM64)
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = AtrisWaveVAD.cat
DriverVer   = 11/24/2026,0.2.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13 ; Driver Store (run-from-DriverStore compliant)

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
AtrisWaveVAD.sys = 1,,

[Manufacturer]
%ManufacturerName% = AtrisWaveVAD_Models, NTamd64.10.0...22000, NTarm64.10.0...22000, NTamd64, NTarm64

[AtrisWaveVAD_Models.NTamd64.10.0...22000]
%DeviceDesc% = AtrisWaveVAD_Device, ROOT\AtrisWaveVAD

[AtrisWaveVAD_Models.NTarm64.10.0...22000]
%DeviceDesc% = AtrisWaveVAD_Device, ROOT\AtrisWaveVAD

[AtrisWaveVAD_Models.NTamd64]
%DeviceDesc% = AtrisWaveVAD_Device, ROOT\AtrisWaveVAD

[AtrisWaveVAD_Models.NTarm64]
%DeviceDesc% = AtrisWaveVAD_Device, ROOT\AtrisWaveVAD

[AtrisWaveVAD_Device.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = AtrisWaveVAD_CopyFiles
AddReg    = AtrisWaveVAD_AddReg

[AtrisWaveVAD_CopyFiles]
AtrisWaveVAD.sys

[AtrisWaveVAD_AddReg]
HKR,,FriendlyName,,%DeviceDesc%
HKR,Parameters,EndpointCount,0x00010001,16
HKR,Parameters\Endpoints\0,FriendlyName,,%EndpointSystem%
HKR,Parameters\Endpoints\0,Direction,0x00010001,0 ; Render (Always Connected)
HKR,Parameters\Endpoints\1,FriendlyName,,%EndpointMic%
HKR,Parameters\Endpoints\1,Direction,0x00010001,1 ; Capture (Mic Out)
HKR,Parameters\Endpoints\2,FriendlyName,,%EndpointStreamMix%
HKR,Parameters\Endpoints\2,Direction,0x00010001,1 ; Capture (Stream Mix)
HKR,Parameters\Endpoints\3,FriendlyName,,%EndpointCh4%
HKR,Parameters\Endpoints\3,Direction,0x00010001,0 ; Render (Dynamic Pool)
HKR,Parameters\Endpoints\4,FriendlyName,,%EndpointCh5%
HKR,Parameters\Endpoints\4,Direction,0x00010001,0
HKR,Parameters\Endpoints\5,FriendlyName,,%EndpointCh6%
HKR,Parameters\Endpoints\5,Direction,0x00010001,0
HKR,Parameters\Endpoints\6,FriendlyName,,%EndpointCh7%
HKR,Parameters\Endpoints\6,Direction,0x00010001,0
HKR,Parameters\Endpoints\7,FriendlyName,,%EndpointCh8%
HKR,Parameters\Endpoints\7,Direction,0x00010001,0
HKR,Parameters\Endpoints\8,FriendlyName,,%EndpointCh9%
HKR,Parameters\Endpoints\8,Direction,0x00010001,0
HKR,Parameters\Endpoints\9,FriendlyName,,%EndpointCh10%
HKR,Parameters\Endpoints\9,Direction,0x00010001,0
HKR,Parameters\Endpoints\10,FriendlyName,,%EndpointCh11%
HKR,Parameters\Endpoints\10,Direction,0x00010001,0
HKR,Parameters\Endpoints\11,FriendlyName,,%EndpointCh12%
HKR,Parameters\Endpoints\11,Direction,0x00010001,0
HKR,Parameters\Endpoints\12,FriendlyName,,%EndpointCh13%
HKR,Parameters\Endpoints\12,Direction,0x00010001,0
HKR,Parameters\Endpoints\13,FriendlyName,,%EndpointCh14%
HKR,Parameters\Endpoints\13,Direction,0x00010001,0
HKR,Parameters\Endpoints\14,FriendlyName,,%EndpointCh15%
HKR,Parameters\Endpoints\14,Direction,0x00010001,0
HKR,Parameters\Endpoints\15,FriendlyName,,%EndpointCh16%
HKR,Parameters\Endpoints\15,Direction,0x00010001,0

[AtrisWaveVAD_Device.NT.Interfaces]
; Control device interface GUID_DEVINTERFACE_ATRISWAVE_VAD
AddInterface = {3713CB20-17E2-4673-8615-F26D528D8255}, "AtrisWaveVADControl", AtrisWaveVAD_Interface_Control
; KS Audio Topology & WaveRT categories (16 Pooled Endpoints)
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveSystem",    AtrisWaveVAD_Interface_System
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveSystem",    AtrisWaveVAD_Interface_System
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveMic",       AtrisWaveVAD_Interface_Mic
AddInterface = %KSCATEGORY_CAPTURE%, "AtrisWaveMic",       AtrisWaveVAD_Interface_Mic
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveStreamMix", AtrisWaveVAD_Interface_StreamMix
AddInterface = %KSCATEGORY_CAPTURE%, "AtrisWaveStreamMix", AtrisWaveVAD_Interface_StreamMix
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh4",       AtrisWaveVAD_Interface_Ch4
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh4",       AtrisWaveVAD_Interface_Ch4
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh5",       AtrisWaveVAD_Interface_Ch5
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh5",       AtrisWaveVAD_Interface_Ch5
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh6",       AtrisWaveVAD_Interface_Ch6
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh6",       AtrisWaveVAD_Interface_Ch6
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh7",       AtrisWaveVAD_Interface_Ch7
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh7",       AtrisWaveVAD_Interface_Ch7
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh8",       AtrisWaveVAD_Interface_Ch8
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh8",       AtrisWaveVAD_Interface_Ch8
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh9",       AtrisWaveVAD_Interface_Ch9
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh9",       AtrisWaveVAD_Interface_Ch9
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh10",      AtrisWaveVAD_Interface_Ch10
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh10",      AtrisWaveVAD_Interface_Ch10
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh11",      AtrisWaveVAD_Interface_Ch11
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh11",      AtrisWaveVAD_Interface_Ch11
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh12",      AtrisWaveVAD_Interface_Ch12
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh12",      AtrisWaveVAD_Interface_Ch12
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh13",      AtrisWaveVAD_Interface_Ch13
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh13",      AtrisWaveVAD_Interface_Ch13
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh14",      AtrisWaveVAD_Interface_Ch14
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh14",      AtrisWaveVAD_Interface_Ch14
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh15",      AtrisWaveVAD_Interface_Ch15
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh15",      AtrisWaveVAD_Interface_Ch15
AddInterface = %KSCATEGORY_AUDIO%,   "AtrisWaveCh16",      AtrisWaveVAD_Interface_Ch16
AddInterface = %KSCATEGORY_RENDER%,  "AtrisWaveCh16",      AtrisWaveVAD_Interface_Ch16

[AtrisWaveVAD_Interface_Control]
AddReg = AtrisWaveVAD_Interface_Control_AddReg
[AtrisWaveVAD_Interface_Control_AddReg]
HKR,,FriendlyName,,%DeviceDesc%

[AtrisWaveVAD_Interface_System]
AddReg = AtrisWaveVAD_Interface_System_AddReg
[AtrisWaveVAD_Interface_System_AddReg]
HKR,,FriendlyName,,%EndpointSystem%
HKR,,CLSID,,%Proxy.CLSID%

[AtrisWaveVAD_Interface_Mic]
AddReg = AtrisWaveVAD_Interface_Mic_AddReg
[AtrisWaveVAD_Interface_Mic_AddReg]
HKR,,FriendlyName,,%EndpointMic%
HKR,,CLSID,,%Proxy.CLSID%

