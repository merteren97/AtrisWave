# ==============================================================================
# AtrisWave .editorconfig
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,cpp,hpp,h,c,xaml}]
indent_style = space
indent_size = 4
end_of_line = lf

[*.{yml,yaml,json,xml,cmake}]
indent_style = space
indent_size = 2
end_of_line = lf

[CMakeLists.txt]
indent_style = space
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
end_of_line = lf

[*.{sln,csproj,vcxproj,inf,ps1,bat,cmd}]
end_of_line = crlf
