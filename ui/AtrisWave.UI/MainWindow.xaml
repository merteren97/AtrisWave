<ui:FluentWindow x:Class="AtrisWave.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:AtrisWave.UI.Controls"
                 xmlns:services="clr-namespace:AtrisWave.UI.Services"
                 Title="{DynamicResource App_Title}"
                 Width="1320"
                 Height="820"
                 MinWidth="1040"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Window.Resources>
        <DataTemplate x:Key="DeviceComboItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Margin="0,0,6,0"
                        Padding="5,1"
                        CornerRadius="4"
                        Background="#3306B6D4"
                        Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource Io_VirtualBadge}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#22D3EE" />
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource App_Title}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True" />

        <!-- Top Studio Status Bar -->
        <Border Grid.Row="1"
                Margin="20,4,20,10"
                Padding="16,10"
                CornerRadius="10"
                Background="#18FFFFFF"
                BorderBrush="#24FFFFFF"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource App_Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0"
                            Padding="8,3"
                            CornerRadius="6"
                            Background="#2638BDF8"
                            BorderBrush="#5538BDF8"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource App_Badge}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,5"
                            Margin="0,0,10,0"
                            CornerRadius="14"
                            Background="#1CFFFFFF"
                            BorderBrush="#2AFFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding IsEngineConnected, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                        <Binding Path="StatusBadgeKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Padding="10,5"
                            Margin="0,0,10,0"
                            CornerRadius="8"
                            Background="#14FFFFFF"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SampleRateDisplay}"
                                   FontSize="12"
                                   Foreground="#CBD5E1"
                                   VerticalAlignment="Center" />
                    </Border>

                    <ui:Button Command="{Binding LaunchOrStopEngineCommand}"
                               Margin="0,0,8,0"
                               Appearance="Secondary"
                               Padding="12,5">
                        <ui:Button.Content>
                            <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                <Binding Path="EngineActionKey" />
                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                            </MultiBinding>
                        </ui:Button.Content>
                    </ui:Button>

                    <ui:Button Content="{DynamicResource Status_PingEngine}"
                               Command="{Binding PingEngineCommand}"
                               ToolTip="{Binding LastPingMessage}"
                               Margin="0,0,6,0"
                               Appearance="Secondary"
                               Padding="12,5" />

                    <TextBlock Text="{Binding LastPingMessage}"
                               FontSize="11"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               MaxWidth="110"
                               TextTrimming="CharacterEllipsis" />

                    <ui:Button Content="{DynamicResource Lang_ToggleLabel}"
                               Command="{Binding ToggleLanguageCommand}"
                               Appearance="Primary"
                               Padding="12,5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-Tab Studio Shell -->
        <TabControl Grid.Row="2"
                    Margin="20,0,20,20"
                    Background="Transparent"
                    BorderThickness="0">
            <!-- TAB 1: Studio Mixer -->
            <TabItem Header="{DynamicResource Tab_StudioMixer}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Hardware I/O Selector Strip -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,12"
                            Padding="14,10"
                            CornerRadius="10"
                            Background="#14FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Io_MicInput}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding InputDevices}"
                                          SelectedItem="{Binding SelectedInputDevice}"
                                          ItemTemplate="{StaticResource DeviceComboItemTemplate}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Io_MonitorOutput}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding SelectedMonitorDevice}"
                                          ItemTemplate="{StaticResource DeviceComboItemTemplate}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource Io_VirtualOutput}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding SelectedVirtualOutputDevice}"
                                          ItemTemplate="{StaticResource DeviceComboItemTemplate}" />
                            </StackPanel>

                            <ui:Button Grid.Column="6"
                                       Content="{DynamicResource Io_RefreshDevices}"
                                       Command="{Binding RefreshDevicesCommand}"
                                       VerticalAlignment="Bottom"
                                       Padding="14,7" />
                        </Grid>
                    </Border>

                    <!-- 6 Virtual Mixer Channels -->
                    <Border Grid.Row="1"
                            Padding="18"
                            CornerRadius="12"
                            Background="#14FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource Mixer_SectionTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Mixer_SectionSubtitle}"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,0"
                                                Padding="10,12"
                                                CornerRadius="10"
                                                Background="#1A0F172A"
                                                BorderBrush="#24FFFFFF"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Height="3"
                                                        CornerRadius="2"
                                                        Margin="0,0,0,8"
                                                        Background="{Binding AccentHex, Converter={StaticResource HexToBrushConverter}}" />

                                                <TextBlock Grid.Row="1"
                                                           HorizontalAlignment="Center"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,10"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                                            <Binding Path="NameKey" />
                                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>

                                                <Grid Grid.Row="2" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>

                                                    <Slider Grid.Column="0"
                                                            Orientation="Vertical"
                                                            Minimum="0"
                                                            Maximum="1.25"
                                                            Value="{Binding Volume, Mode=TwoWay}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Stretch"
                                                            TickFrequency="0.25"
                                                            IsMoveToPointEnabled="True" />

                                                    <controls:VuMeterControl Grid.Column="1"
                                                                             PeakLeft="{Binding PeakLeft}"
                                                                             PeakRight="{Binding PeakRight}"
                                                                             RmsLeft="{Binding RmsLeft}"
                                                                             RmsRight="{Binding RmsRight}"
                                                                             IsMuted="{Binding IsMuted}"
                                                                             IsClipping="{Binding IsClipping}" />
                                                </Grid>

                                                <TextBlock Grid.Row="3"
                                                           Text="{Binding VolumeDbText}"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#CBD5E1"
                                                           Margin="0,0,0,8" />

                                                <UniformGrid Grid.Row="4" Rows="1" Columns="2">
                                                    <ToggleButton Content="{DynamicResource Channel_MuteShort}"
                                                                  IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                                  ToolTip="{DynamicResource Channel_MuteTooltip}"
                                                                  Margin="0,0,3,0"
                                                                  Height="30"
                                                                  FontWeight="Bold" />
                                                    <ToggleButton Content="{DynamicResource Channel_SoloShort}"
                                                                  IsChecked="{Binding IsSolo, Mode=TwoWay}"
                                                                  ToolTip="{DynamicResource Channel_SoloTooltip}"
                                                                  Margin="3,0,0,0"
                                                                  Height="30"
                                                                  FontWeight="Bold" />
                                                </UniformGrid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Mic Gain Reduction Telemetry Bar -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,12,4,0">
                                <TextBlock Text="{DynamicResource Channel_GrLabel}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#F59E0B"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ProgressBar Width="220"
                                             Height="8"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding MicGainReductionNormalized}"
                                             Foreground="#F59E0B"
                                             VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Mic DSP Studio -->
            <TabItem Header="{DynamicResource Tab_MicDsp}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="210" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Preset Bar -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,10"
                            Padding="14,8"
                            CornerRadius="10"
                            Background="#14FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Dsp_EqCurveTitle}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Dsp_Phase1Note}" FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Dsp_PresetLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CBD5E1" />
                                <ComboBox Width="180"
                                          IsEditable="True"
                                          ItemsSource="{Binding Presets}"
                                          Text="{Binding PresetNameInput, Mode=TwoWay}"
                                          Margin="0,0,8,0" />
                                <ui:Button Content="{DynamicResource Dsp_SavePreset}" Command="{Binding SavePresetCommand}" Margin="0,0,6,0" />
                                <ui:Button Content="{DynamicResource Dsp_LoadPreset}" Command="{Binding LoadPresetCommand}" Appearance="Primary" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Interactive 5-Band Parametric EQ Visualizer -->
                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="6"
                            CornerRadius="10"
                            Background="#14FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">
                        <controls:EqCurveControl Settings="{Binding MicDsp}" />
                    </Border>

                    <!-- DSP Module Parameter Cards -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <UniformGrid Columns="3">
                            <!-- Card 1: Direct Monitor + Denoise -->
                            <Border Margin="0,0,8,8" Padding="14" CornerRadius="10" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.DirectMonitor, Mode=TwoWay}" />
                                        <TextBlock Text="{DynamicResource Dsp_DirectMonitor_Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Dsp_DirectMonitor_Desc}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6" />
                                    <TextBlock Text="{DynamicResource Dsp_MonitorGain}" FontSize="11" />
                                    <Slider Minimum="0" Maximum="1.5" Value="{Binding MicDsp.MonitorGain, Mode=TwoWay}" Margin="0,0,0,12" />

                                    <DockPanel Margin="0,0,0,6">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.DenoiseEnabled, Mode=TwoWay}" />
                                        <TextBlock Text="{DynamicResource Dsp_AiDenoise_Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Dsp_AiDenoise_Desc}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6" />
                                    <TextBlock Text="{DynamicResource Dsp_DenoiseStrength}" FontSize="11" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding MicDsp.DenoiseStrength, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Noise Gate + 5-Band EQ -->
                            <Border Margin="4,0,4,8" Padding="14" CornerRadius="10" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.GateEnabled, Mode=TwoWay}" />
                                        <TextBlock Text="{DynamicResource Dsp_NoiseGate_Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Dsp_GateThreshold}" FontSize="11" />
                                    <Slider Minimum="-80" Maximum="-10" Value="{Binding MicDsp.GateThresholdDb, Mode=TwoWay}" Margin="0,0,0,10" />

                                    <DockPanel Margin="0,0,0,6">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.EqEnabled, Mode=TwoWay}" />
                                        <TextBlock Text="{DynamicResource Dsp_ParametricEq_Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Dsp_EqHpf}" FontSize="11" />
                                    <Slider Minimum="20" Maximum="300" Value="{Binding MicDsp.EqHpfHz, Mode=TwoWay}" />
                                    <TextBlock Text="{DynamicResource Dsp_EqLow}" FontSize="11" />
                                    <Slider Minimum="-15" Maximum="15" Value="{Binding MicDsp.EqLowDb, Mode=TwoWay}" />
                                    <TextBlock Text="{DynamicResource Dsp_EqMid1}" FontSize="11" />
                                    <Slider Minimum="-15" Maximum="15" Value="{Binding MicDsp.EqMid1Db, Mode=TwoWay}" />
                                    <TextBlock Text="{DynamicResource Dsp_EqMid2}" FontSize="11" />
                                    <Slider Minimum="-15" Maximum="15" Value="{Binding MicDsp.EqMid2Db, Mode=TwoWay}" />
                                    <TextBlock Text="{DynamicResource Dsp_EqHigh}" FontSize="11" />
                                    <Slider Minimum="-15" Maximum="15" Value="{Binding MicDsp.EqHighDb, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Compressor + Ducking + Reverb + Limiter -->
                            <Border Margin="8,0,0,8" Padding="14" CornerRadius="10" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.CompEnabled, Mode=TwoWay}" />
                                        <TextBlock Text="{DynamicResource Dsp_Compressor_Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Dsp_CompThreshold}" FontSize="11" />
                                    <Slider Minimum="-45" Maximum="0" Value="{Binding MicDsp.CompThresholdDb, Mode=TwoWay}" />
                                    <TextBlock Text="{DynamicResource Dsp_CompRatio}" FontSize="11" />
                                    <Slider Minimum="1" Maximum="12" Value="{Binding MicDsp.CompRatio, Mode=TwoWay}" />
                                    <TextBlock Text="{DynamicResource Dsp_CompMakeup}" FontSize="11" />
                                    <Slider Minimum="0" Maximum="18" Value="{Binding MicDsp.CompMakeupDb, Mode=TwoWay}" Margin="0,0,0,8" />

                                    <DockPanel Margin="0,0,0,4">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.DuckingEnabled, Mode=TwoWay}" />
                                        <TextBlock Text="{DynamicResource Dsp_DuckingTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Dsp_DuckingDepth}" FontSize="11" />
                                    <Slider Minimum="-30" Maximum="0" Value="{Binding MicDsp.DuckingDepthDb, Mode=TwoWay}" Margin="0,0,0,8" />

                                    <DockPanel Margin="0,0,0,4">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.ReverbEnabled, Mode=TwoWay}" />
                                        <TextBlock Text="{DynamicResource Dsp_Reverb_Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Dsp_ReverbWet}" FontSize="11" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding MicDsp.ReverbWet, Mode=TwoWay}" Margin="0,0,0,8" />

                                    <DockPanel Margin="0,0,0,4">
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.LimiterEnabled, Mode=TwoWay}" />
                                        <TextBlock Text="{DynamicResource Dsp_Limiter_Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Dsp_LimiterCeiling}" FontSize="11" />
                                    <Slider Minimum="-6" Maximum="0" Value="{Binding MicDsp.LimiterCeilingDb, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: App Routing -->
            <TabItem Header="{DynamicResource Tab_AppRouting}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Virtual Audio Driver Status Banner -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,10"
                            Padding="14,10"
                            CornerRadius="10"
                            Background="#14FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right"
                                       Content="{DynamicResource Driver_RefreshStatus}"
                                       Command="{Binding RefreshDriverStatusCommand}"
                                       Appearance="Secondary"
                                       Padding="12,5" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10"
                                         Height="10"
                                         Margin="0,0,10,0"
                                         Fill="{Binding IsDriverInstalled, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                            <Binding Path="DriverStatusKey" />
                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- One-Click & Drag-and-Drop Virtual Channel Assignment Pills -->
                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="14,10"
                            CornerRadius="10"
                            Background="#14FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Driver_DropHint}"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,8" />
                            <UniformGrid Rows="1" Columns="4">
                                <Button Content="{DynamicResource Channel_Game}"
                                        Command="{Binding AssignSelectedSessionToChannelCommand}"
                                        CommandParameter="Game"
                                        Tag="Game"
                                        AllowDrop="True"
                                        DragOver="OnChannelPillDragOver"
                                        Drop="OnChannelPillDrop"
                                        Margin="0,0,6,0"
                                        Padding="10,7"
                                        Background="#26A855F7"
                                        BorderBrush="#77A855F7"
                                        FontWeight="SemiBold" />
                                <Button Content="{DynamicResource Channel_Chat}"
                                        Command="{Binding AssignSelectedSessionToChannelCommand}"
                                        CommandParameter="Chat"
                                        Tag="Chat"
                                        AllowDrop="True"
                                        DragOver="OnChannelPillDragOver"
                                        Drop="OnChannelPillDrop"
                                        Margin="3,0,3,0"
                                        Padding="10,7"
                                        Background="#2610B981"
                                        BorderBrush="#7710B981"
                                        FontWeight="SemiBold" />
                                <Button Content="{DynamicResource Channel_Media}"
                                        Command="{Binding AssignSelectedSessionToChannelCommand}"
                                        CommandParameter="Media"
                                        Tag="Media"
                                        AllowDrop="True"
                                        DragOver="OnChannelPillDragOver"
                                        Drop="OnChannelPillDrop"
                                        Margin="3,0,3,0"
                                        Padding="10,7"
                                        Background="#26F59E0B"
                                        BorderBrush="#77F59E0B"
                                        FontWeight="SemiBold" />
                                <Button Content="{DynamicResource Channel_Aux}"
                                        Command="{Binding AssignSelectedSessionToChannelCommand}"
                                        CommandParameter="Aux"
                                        Tag="Aux"
                                        AllowDrop="True"
                                        DragOver="OnChannelPillDragOver"
                                        Drop="OnChannelPillDrop"
                                        Margin="6,0,0,0"
                                        Padding="10,7"
                                        Background="#26EC4899"
                                        BorderBrush="#77EC4899"
                                        FontWeight="SemiBold" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Active Sessions + Persistent Rules Split -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.0*" />
                        </Grid.ColumnDefinitions>

                        <!-- Active Audio Sessions -->
                        <Border Grid.Column="0"
                                Padding="16"
                                CornerRadius="12"
                                Background="#14FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <ui:Button DockPanel.Dock="Right"
                                               Content="{DynamicResource Routing_RefreshSessions}"
                                               Command="{Binding RefreshSessionsCommand}"
                                               Appearance="Primary"
                                               Padding="14,7" />
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Routing_Title}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource Routing_Subtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding AudioSessions}"
                                          SelectedItem="{Binding SelectedAudioSession, Mode=TwoWay}"
                                          PreviewMouseLeftButtonDown="OnSessionsGridPreviewMouseDown"
                                          MouseMove="OnSessionsGridMouseMove"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="False"
                                          HeadersVisibility="Column"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource Routing_ColApp}" Binding="{Binding EffectiveLabel}" IsReadOnly="True" Width="1.6*" />
                                        <DataGridTextColumn Header="{DynamicResource Routing_ColPid}" Binding="{Binding Pid}" IsReadOnly="True" Width="70" />
                                        <DataGridTextColumn Header="{DynamicResource Routing_ColVolume}" Binding="{Binding Volume, StringFormat=P0}" IsReadOnly="True" Width="75" />
                                        <DataGridTemplateColumn Header="{DynamicResource Routing_ColTargetDevice}" Width="1.8*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              SelectedValue="{Binding TargetDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="Name"
                                                              SelectionChanged="OnSessionDeviceSelectionChanged" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{DynamicResource Routing_ColLoopback}" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:ToggleSwitch IsChecked="{Binding LoopbackCapture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Command="{Binding DataContext.RouteAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                     CommandParameter="{Binding}"
                                                                     HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Saved Persistent Routing Rules -->
                        <Border Grid.Column="2"
                                Padding="16"
                                CornerRadius="12"
                                Background="#14FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <ui:Button DockPanel.Dock="Right"
                                               Content="{DynamicResource Rules_ApplyAll}"
                                               Command="{Binding ApplyAllRoutingRulesCommand}"
                                               Appearance="Secondary"
                                               Padding="10,6" />
                                    <TextBlock Text="{DynamicResource Rules_Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RoutingRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="10,8"
                                                        CornerRadius="8"
                                                        Background="#1A0F172A"
                                                        BorderBrush="#22FFFFFF"
                                                        BorderThickness="1">
                                                    <DockPanel>
                                                        <ui:Button DockPanel.Dock="Right"
                                                                   Content="{DynamicResource Rules_Delete}"
                                                                   Command="{Binding DataContext.DeleteRoutingRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   Appearance="Danger"
                                                                   Padding="8,4" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock FontSize="11" Foreground="#94A3B8">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                                                        <Binding Path="ChannelNameKey" />
                                                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
