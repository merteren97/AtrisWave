<Window x:Class="AtrisWave.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AtrisWave.UI.Views"
        Title="{DynamicResource App_Title}"
        Icon="pack://application:,,,/AtrisWave.UI;component/Resources/atriswave.ico"
        Width="1380"
        Height="850"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#070A10"
        Foreground="#F8FAFC">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="#070A10">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Unified 44px Frameless Studio Title Bar -->
        <Border Grid.Row="0"
                Background="#CC0B0F17"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0,0,0,1"
                Padding="14,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Brand + Version Pill + Clickable Engine Status Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/AtrisWave.UI;component/Resources/atriswave.ico"
                           Width="20"
                           Height="20"
                           Margin="0,0,9,0" />
                    <TextBlock Text="{DynamicResource App_Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center" />
                    <Border Margin="8,0,0,0"
                            Padding="7,2"
                            CornerRadius="10"
                            Background="#1638BDF8"
                            BorderBrush="#3338BDF8"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentAppVersion, StringFormat=v{0}}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#7DD3FC" />
                    </Border>

                    <!-- Clickable Engine Status Pill (navigates to Settings/Diagnostics) -->
                    <Button Command="{Binding SelectNavCommand}"
                            CommandParameter="4"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Margin="12,0,0,0"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="PillBd"
                                        Height="30"
                                        Padding="11,0"
                                        CornerRadius="12"
                                        Background="#1A2436"
                                        BorderBrush="#334155"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding IsEngineConnected, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                                        <TextBlock Text="{Binding EngineStatusBadgeText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E2E8F0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding EngineDiagnosticsText}"
                                                   FontSize="10.5"
                                                   Foreground="#94A3B8"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PillBd" Property="Background" Value="#2038BDF8" />
                                        <Setter TargetName="PillBd" Property="BorderBrush" Value="#5538BDF8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Right: Update Badge + Global Mic Mute + Window Caption Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SelectNavCommand}"
                            CommandParameter="4"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Margin="0,0,8,0"
                            Padding="9,4"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="12"
                                        Background="#2210B981"
                                        BorderBrush="#6610B981"
                                        BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon_Download}" Width="12" Height="12" Stretch="Uniform" Stroke="#34D399" StrokeThickness="1.8" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Update_BadgeAvailable}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ToggleButton IsChecked="{Binding PrimaryMicChannel.Muted, Mode=TwoWay}"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  Height="30"
                                  Margin="0,0,10,0"
                                  Padding="11,0"
                                  VerticalAlignment="Center"
                                  Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd"
                                        CornerRadius="8"
                                        Background="#1E293B"
                                        BorderBrush="#3B4E6B"
                                        BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path x:Name="MicIcon" Data="{StaticResource Icon_Mic}" Width="13" Height="13" Stretch="Uniform" Stroke="#F1F5F9" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="MicText" Text="{DynamicResource Flyout_MicMute}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#263954" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4C1D24" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4444" />
                                        <Setter TargetName="MicIcon" Property="Data" Value="{StaticResource Icon_MicMuted}" />
                                        <Setter TargetName="MicIcon" Property="Stroke" Value="#FCA5A5" />
                                        <Setter TargetName="MicText" Property="Foreground" Value="#FCA5A5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Caption Buttons -->
                    <Button Style="{StaticResource TitleBarCaptionButtonStyle}"
                            Click="OnMinimizeClick"
                            ToolTip="{DynamicResource Caption_Minimize}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 0,0 L 10,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
                    </Button>

                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource TitleBarCaptionButtonStyle}"
                            Click="OnMaximizeRestoreClick"
                            ToolTip="{DynamicResource Caption_Maximize}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MaximizeRestoreIcon"
                              Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
                    </Button>

                    <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="OnCloseClick"
                            ToolTip="{DynamicResource Caption_Close}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Obsidian Studio Shell: Left Fluent Navigation Rail + Active View -->
        <Grid Grid.Row="1" Margin="14,12,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Fluent Navigation Rail -->
            <Border Grid.Column="0"
                    Padding="8"
                    CornerRadius="12"
                    Background="#990B0F17"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">
                <ListBox SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="#CBD5E1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="8"
                                                Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="AccentPill"
                                                        Width="3"
                                                        Height="16"
                                                        CornerRadius="2"
                                                        Margin="0,0,10,0"
                                                        Background="Transparent" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2438BDF8" />
                                                <Setter TargetName="AccentPill" Property="Background" Value="#38BDF8" />
                                                <Setter Property="Foreground" Value="#F8FAFC" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Mixer}" Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Nav_Mixer}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Mic}" Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Nav_MicStudio}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Routing}" Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Nav_AppRouting}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Soundboard}" Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Nav_Soundboard}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Settings}" Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.8" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Nav_Settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Active Modular View -->
            <Grid Grid.Column="2">
                <views:MixerView>
                    <views:MixerView.Style>
                        <Style TargetType="views:MixerView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MixerView.Style>
                </views:MixerView>

                <views:MicStudioView>
                    <views:MicStudioView.Style>
                        <Style TargetType="views:MicStudioView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MicStudioView.Style>
                </views:MicStudioView>

                <views:AppRoutingView>
                    <views:AppRoutingView.Style>
                        <Style TargetType="views:AppRoutingView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AppRoutingView.Style>
                </views:AppRoutingView>

                <views:SoundboardView>
                    <views:SoundboardView.Style>
                        <Style TargetType="views:SoundboardView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SoundboardView.Style>
                </views:SoundboardView>

                <views:SettingsView>
                    <views:SettingsView.Style>
                        <Style TargetType="views:SettingsView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SettingsView.Style>
                </views:SettingsView>
            </Grid>
        </Grid>
    </Grid>
</Window>
