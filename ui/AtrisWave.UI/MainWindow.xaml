<ui:FluentWindow x:Class="AtrisWave.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:AtrisWave.UI.Views"
                 xmlns:services="clr-namespace:AtrisWave.UI.Services"
                 Title="{DynamicResource App_Title}"
                 Icon="pack://application:,,,/AtrisWave.UI;component/Resources/atriswave.ico"
                 Width="1380"
                 Height="850"
                 MinWidth="1080"
                 MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Background="#CC070A10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource App_Title}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True" />

        <!-- Top Studio Status Bar -->
        <Border Grid.Row="1"
                Margin="16,4,16,10"
                Padding="14,9"
                CornerRadius="10"
                Background="#990B0F17"
                BorderBrush="#24FFFFFF"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/AtrisWave.UI;component/Resources/atriswave.ico"
                           Width="22"
                           Height="22"
                           Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource App_Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0"
                            Padding="8,3"
                            CornerRadius="6"
                            Background="#2638BDF8"
                            BorderBrush="#5538BDF8"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource App_Badge}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,5"
                            Margin="0,0,10,0"
                            CornerRadius="14"
                            Background="#1CFFFFFF"
                            BorderBrush="#2AFFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding IsEngineConnected, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                        <Binding Path="StatusBadgeKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Padding="10,5"
                            Margin="0,0,10,0"
                            CornerRadius="8"
                            Background="#14FFFFFF"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SampleRateDisplay}"
                                   FontSize="12"
                                   Foreground="#CBD5E1"
                                   VerticalAlignment="Center" />
                    </Border>

                    <ui:Button Command="{Binding LaunchOrStopEngineCommand}"
                               Margin="0,0,8,0"
                               Appearance="Secondary"
                               Padding="12,5">
                        <ui:Button.Content>
                            <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                <Binding Path="EngineActionKey" />
                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                            </MultiBinding>
                        </ui:Button.Content>
                    </ui:Button>

                    <ui:Button Content="{DynamicResource Status_PingEngine}"
                               Command="{Binding PingEngineCommand}"
                               ToolTip="{Binding LastPingMessage}"
                               Margin="0,0,6,0"
                               Appearance="Secondary"
                               Padding="12,5" />

                    <TextBlock Text="{Binding LastPingMessage}"
                               FontSize="11"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               MaxWidth="100"
                               TextTrimming="CharacterEllipsis" />

                    <ui:Button Content="{DynamicResource Lang_ToggleLabel}"
                               Command="{Binding ToggleLanguageCommand}"
                               Appearance="Primary"
                               Padding="12,5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Obsidian Studio Shell: Left Fluent Navigation Rail + Active View -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Fluent Navigation Rail -->
            <Border Grid.Column="0"
                    Padding="8"
                    CornerRadius="12"
                    Background="#990B0F17"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">
                <ListBox SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="#CBD5E1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="8"
                                                Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="AccentPill"
                                                        Width="3"
                                                        Height="16"
                                                        CornerRadius="2"
                                                        Margin="0,0,10,0"
                                                        Background="Transparent" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2438BDF8" />
                                                <Setter TargetName="AccentPill" Property="Background" Value="#38BDF8" />
                                                <Setter Property="Foreground" Value="#F8FAFC" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem Content="{DynamicResource Nav_Mixer}" />
                    <ListBoxItem Content="{DynamicResource Nav_MicStudio}" />
                    <ListBoxItem Content="{DynamicResource Nav_AppRouting}" />
                    <ListBoxItem Content="{DynamicResource Nav_Soundboard}" />
                    <ListBoxItem Content="{DynamicResource Nav_ProAutomation}" />
                </ListBox>
            </Border>

            <!-- Active Modular View -->
            <Grid Grid.Column="2">
                <views:MixerView>
                    <views:MixerView.Style>
                        <Style TargetType="views:MixerView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MixerView.Style>
                </views:MixerView>

                <views:MicStudioView>
                    <views:MicStudioView.Style>
                        <Style TargetType="views:MicStudioView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MicStudioView.Style>
                </views:MicStudioView>

                <views:AppRoutingView>
                    <views:AppRoutingView.Style>
                        <Style TargetType="views:AppRoutingView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AppRoutingView.Style>
                </views:AppRoutingView>

                <views:SoundboardView>
                    <views:SoundboardView.Style>
                        <Style TargetType="views:SoundboardView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SoundboardView.Style>
                </views:SoundboardView>

                <views:ProAutomationView>
                    <views:ProAutomationView.Style>
                        <Style TargetType="views:ProAutomationView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ProAutomationView.Style>
                </views:ProAutomationView>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
