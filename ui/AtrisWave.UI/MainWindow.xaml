<ui:FluentWindow x:Class="AtrisWave.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:AtrisWave.UI.Controls"
                 xmlns:services="clr-namespace:AtrisWave.UI.Services"
                 Title="{DynamicResource App_Title}"
                 Width="1240"
                 Height="760"
                 MinWidth="980"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource App_Title}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True" />

        <!-- Top Studio Status Bar -->
        <Border Grid.Row="1"
                Margin="20,4,20,12"
                Padding="16,10"
                CornerRadius="10"
                Background="#18FFFFFF"
                BorderBrush="#24FFFFFF"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand + Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource App_Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0"
                            Padding="8,3"
                            CornerRadius="6"
                            Background="#2638BDF8"
                            BorderBrush="#5538BDF8"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource App_Badge}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8" />
                    </Border>
                </StackPanel>

                <!-- Status Pill + Sample Rate + Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,5"
                            Margin="0,0,10,0"
                            CornerRadius="14"
                            Background="#1CFFFFFF"
                            BorderBrush="#2AFFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding IsEngineConnected, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                        <Binding Path="StatusBadgeKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Padding="10,5"
                            Margin="0,0,10,0"
                            CornerRadius="8"
                            Background="#14FFFFFF"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SampleRateDisplay}"
                                   FontSize="12"
                                   Foreground="#CBD5E1"
                                   VerticalAlignment="Center" />
                    </Border>

                    <ui:Button Content="{DynamicResource Status_PingEngine}"
                               Command="{Binding PingEngineCommand}"
                               ToolTip="{Binding LastPingMessage}"
                               Margin="0,0,8,0"
                               Appearance="Secondary"
                               Padding="12,5" />

                    <TextBlock Text="{Binding LastPingMessage}"
                               FontSize="11"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               MaxWidth="140"
                               TextTrimming="CharacterEllipsis" />

                    <ui:Button Content="{DynamicResource Lang_ToggleLabel}"
                               Command="{Binding ToggleLanguageCommand}"
                               Appearance="Primary"
                               Padding="12,5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace: 6-Channel Mixer + Mic DSP Preview -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- Virtual Mixer Channels Panel -->
            <Border Grid.Column="0"
                    Padding="18"
                    CornerRadius="12"
                    Background="#14FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Mixer_SectionTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Mixer_SectionSubtitle}"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,0"
                                        Padding="10,12"
                                        CornerRadius="10"
                                        Background="#1A0F172A"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Accent Strip -->
                                        <Border Grid.Row="0"
                                                Height="3"
                                                CornerRadius="2"
                                                Margin="0,0,0,8"
                                                Background="{Binding AccentHex, Converter={StaticResource HexToBrushConverter}}" />

                                        <!-- Channel Name -->
                                        <TextBlock Grid.Row="1"
                                                   HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                                    <Binding Path="NameKey" />
                                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <!-- Vertical Fader + 60fps SkiaSharp VU Meter -->
                                        <Grid Grid.Row="2" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>

                                            <Slider Grid.Column="0"
                                                    Orientation="Vertical"
                                                    Minimum="0"
                                                    Maximum="1.25"
                                                    Value="{Binding Volume, Mode=TwoWay}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Stretch"
                                                    TickFrequency="0.25"
                                                    IsMoveToPointEnabled="True" />

                                            <controls:VuMeterControl Grid.Column="1"
                                                                     PeakLeft="{Binding PeakLeft}"
                                                                     PeakRight="{Binding PeakRight}"
                                                                     RmsLeft="{Binding RmsLeft}"
                                                                     RmsRight="{Binding RmsRight}"
                                                                     IsMuted="{Binding IsMuted}"
                                                                     IsClipping="{Binding IsClipping}" />
                                        </Grid>

                                        <!-- dB Readout -->
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding VolumeDbText}"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="#CBD5E1"
                                                   Margin="0,0,0,8" />

                                        <!-- Mute / Solo Toggles -->
                                        <UniformGrid Grid.Row="4" Rows="1" Columns="2">
                                            <ToggleButton Content="{DynamicResource Channel_MuteShort}"
                                                          IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                          ToolTip="{DynamicResource Channel_MuteTooltip}"
                                                          Margin="0,0,3,0"
                                                          Height="30"
                                                          FontWeight="Bold" />
                                            <ToggleButton Content="{DynamicResource Channel_SoloShort}"
                                                          IsChecked="{Binding IsSolo, Mode=TwoWay}"
                                                          ToolTip="{DynamicResource Channel_SoloTooltip}"
                                                          Margin="3,0,0,0"
                                                          Height="30"
                                                          FontWeight="Bold" />
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Right Panel: Phase 1 Dual-Path Microphone DSP Preview -->
            <Border Grid.Column="2"
                    Padding="18"
                    CornerRadius="12"
                    Background="#14FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Dsp_SectionTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Dsp_SectionSubtitle}"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MicDspModules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12,10"
                                            CornerRadius="8"
                                            Background="#1A0F172A"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                                                <Binding Path="NameKey" />
                                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <Border Margin="8,0,0,0"
                                                            Padding="6,2"
                                                            CornerRadius="4"
                                                            Background="#2206B6D4">
                                                        <TextBlock Text="{Binding BadgeText}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#22D3EE" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="11"
                                                           Foreground="#94A3B8"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                                            <Binding Path="DescriptionKey" />
                                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>

                                            <ui:ToggleSwitch Grid.Column="1"
                                                             IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                             VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            CornerRadius="6"
                            Background="#1A38BDF8">
                        <TextBlock Text="{DynamicResource Dsp_Phase1Note}"
                                   FontSize="11"
                                   Foreground="#BAE6FD"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
