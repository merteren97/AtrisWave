<ui:FluentWindow x:Class="AtrisWave.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:AtrisWave.UI.Views"
                 xmlns:services="clr-namespace:AtrisWave.UI.Services"
                 Title="{DynamicResource App_Title}"
                 Icon="pack://application:,,,/AtrisWave.UI;component/Resources/atriswave.ico"
                 Width="1380"
                 Height="850"
                 MinWidth="1080"
                 MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Background="#CC070A10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource App_Title}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True" />

        <!-- Ultra-Clean Minimal Top Header -->
        <Border Grid.Row="1"
                Margin="16,4,16,10"
                Padding="16,10"
                CornerRadius="12"
                Background="#990B0F17"
                BorderBrush="#1EFFFFFF"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/AtrisWave.UI;component/Resources/atriswave.ico"
                           Width="22"
                           Height="22"
                           Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource App_Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Ellipse Width="8"
                             Height="8"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Fill="{Binding IsEngineConnected, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{DynamicResource Flyout_MicMute}"
                               Command="{Binding ToggleMicMuteCommand}"
                               Appearance="Secondary"
                               Padding="14,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Obsidian Studio Shell: Left Fluent Navigation Rail + Active View -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Fluent Navigation Rail -->
            <Border Grid.Column="0"
                    Padding="8"
                    CornerRadius="12"
                    Background="#990B0F17"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">
                <ListBox SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="#CBD5E1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="8"
                                                Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="AccentPill"
                                                        Width="3"
                                                        Height="16"
                                                        CornerRadius="2"
                                                        Margin="0,0,10,0"
                                                        Background="Transparent" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2438BDF8" />
                                                <Setter TargetName="AccentPill" Property="Background" Value="#38BDF8" />
                                                <Setter Property="Foreground" Value="#F8FAFC" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem Content="{DynamicResource Nav_Mixer}" />
                    <ListBoxItem Content="{DynamicResource Nav_MicStudio}" />
                    <ListBoxItem Content="{DynamicResource Nav_AppRouting}" />
                    <ListBoxItem Content="{DynamicResource Nav_Soundboard}" />
                    <ListBoxItem Content="{DynamicResource Nav_Settings}" />
                </ListBox>
            </Border>

            <!-- Active Modular View -->
            <Grid Grid.Column="2">
                <views:MixerView>
                    <views:MixerView.Style>
                        <Style TargetType="views:MixerView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MixerView.Style>
                </views:MixerView>

                <views:MicStudioView>
                    <views:MicStudioView.Style>
                        <Style TargetType="views:MicStudioView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MicStudioView.Style>
                </views:MicStudioView>

                <views:AppRoutingView>
                    <views:AppRoutingView.Style>
                        <Style TargetType="views:AppRoutingView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AppRoutingView.Style>
                </views:AppRoutingView>

                <views:SoundboardView>
                    <views:SoundboardView.Style>
                        <Style TargetType="views:SoundboardView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SoundboardView.Style>
                </views:SoundboardView>

                <views:SettingsView>
                    <views:SettingsView.Style>
                        <Style TargetType="views:SettingsView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SettingsView.Style>
                </views:SettingsView>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
