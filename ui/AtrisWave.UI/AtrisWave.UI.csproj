<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.1.2</Version>
    <ApplicationTitle>AtrisWave</ApplicationTitle>
    <ApplicationIcon>Resources\atriswave.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\atriswave.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.4" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtrisWave.Core\AtrisWave.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyNativeEngineBinaries" AfterTargets="Build">
    <PropertyGroup>
      <_EngineReleaseDir>$(MSBuildProjectDirectory)\..\..\engine\build\msvc-release</_EngineReleaseDir>
      <_EngineDebugDir>$(MSBuildProjectDirectory)\..\..\engine\build\msvc-debug</_EngineDebugDir>
      <_EngineSourceDir Condition="Exists('$(_EngineReleaseDir)\AtrisWaveEngine.exe')">$(_EngineReleaseDir)</_EngineSourceDir>
      <_EngineSourceDir Condition="'$(_EngineSourceDir)' == '' and Exists('$(_EngineDebugDir)\AtrisWaveEngine.exe')">$(_EngineDebugDir)</_EngineSourceDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_EngineSourceDir)\AtrisWaveEngine.exe"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'$(_EngineSourceDir)' != '' and Exists('$(_EngineSourceDir)\AtrisWaveEngine.exe')" />
    <Copy SourceFiles="$(_EngineSourceDir)\AtrisWaveWatchdog.exe"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'$(_EngineSourceDir)' != '' and Exists('$(_EngineSourceDir)\AtrisWaveWatchdog.exe')" />
  </Target>

</Project>
