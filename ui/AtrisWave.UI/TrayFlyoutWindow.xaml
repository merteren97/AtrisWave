<Window x:Class="AtrisWave.UI.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border Padding="14"
            CornerRadius="12"
            Background="#EE0B0F17"
            BorderBrush="#3338BDF8"
            BorderThickness="1">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <ui:Button DockPanel.Dock="Right"
                           Content="{DynamicResource Flyout_QuickBusSwitch}"
                           Command="{Binding ToggleA1A2QuickOutputCommand}"
                           Appearance="Secondary"
                           Padding="8,4"
                           FontSize="11" />
                <TextBlock Text="{DynamicResource Flyout_Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#F8FAFC"
                           VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding DynamicChannels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       Foreground="#CBD5E1"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1.25"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding VolumeDbText}"
                                       Foreground="#94A3B8"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Rows="1" Columns="2" Margin="0,6,0,0">
                <ui:Button Content="{DynamicResource Flyout_MicMute}"
                           Command="{Binding ToggleMicMuteCommand}"
                           Appearance="Secondary"
                           Margin="0,0,4,0" />
                <ui:Button Content="{DynamicResource Flyout_OpenStudio}"
                           Click="OnOpenStudioClick"
                           Appearance="Primary"
                           Margin="4,0,0,0" />
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
