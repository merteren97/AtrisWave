<UserControl x:Class="AtrisWave.UI.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:AtrisWave.UI.Controls"
             xmlns:services="clr-namespace:AtrisWave.UI.Services">
    <UserControl.Resources>
        <DataTemplate x:Key="DeviceComboItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Margin="0,0,6,0"
                        Padding="5,1"
                        CornerRadius="4"
                        Background="#3306B6D4"
                        Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource Io_VirtualBadge}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#22D3EE" />
                </Border>
                <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Health Warning Banner (1-Click Auto-Setup) -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="14,10"
                CornerRadius="10"
                Background="#26F59E0B"
                BorderBrush="#66F59E0B"
                BorderThickness="1"
                Visibility="{Binding IsHealthWarning, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource StudioPrimaryButtonStyle}"
                        Content="{DynamicResource Health_AutoSetup}"
                        Command="{Binding AutoSetupDefaultsCommand}"
                        Margin="12,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HealthWarningMessage}"
                               Foreground="#FDE68A"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error / IPC Diagnostic Banner -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="14,9"
                CornerRadius="10"
                Background="#26EF4444"
                BorderBrush="#66EF4444"
                BorderThickness="1"
                Visibility="{Binding HasLastError, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource StudioSecondaryButtonStyle}"
                        Content="{DynamicResource Io_RefreshDevices}"
                        Command="{Binding RefreshDevicesCommand}"
                        Margin="12,0,0,0" />
                <TextBlock Text="{Binding LastErrorMessage}"
                           Foreground="#FCA5A5"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Main Mixer Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Left/Main Area: Dynamic Virtual Channels + Overlay Channel DSP Drawer -->
            <Grid Grid.Column="0">
                <Border Style="{StaticResource StudioCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource StudioPrimaryButtonStyle}"
                                    Command="{Binding ToggleNewChannelCreatorCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon_Plus}" Width="13" Height="13" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="2" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Ch_AddChannel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Mixer_SectionTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                <TextBlock Text="{DynamicResource Mixer_SectionSubtitle}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Inline New Channel Creator -->
                        <Border Grid.Row="1"
                                Margin="0,0,0,14"
                                Padding="12"
                                CornerRadius="10"
                                Background="#131926"
                                BorderBrush="#4438BDF8"
                                BorderThickness="1"
                                Visibility="{Binding IsNewChannelCreatorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Text="{DynamicResource Ch_NewNameLabel}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <TextBox Width="150" Height="36" Text="{Binding NewChannelName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Text="{DynamicResource Ch_SourceAppGroup}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <ComboBox Width="150" Height="36" SelectedIndex="{Binding NewChannelSourceIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{DynamicResource Ch_SourceAppGroup}" />
                                        <ComboBoxItem Content="{DynamicResource Ch_SourceMic}" />
                                        <ComboBoxItem Content="{DynamicResource Ch_SourceLoopback}" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Text="{DynamicResource Ch_BindAppLabel}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <ComboBox Width="160"
                                              Height="36"
                                              IsEditable="True"
                                              ItemsSource="{Binding AudioSessions}"
                                              DisplayMemberPath="AppName"
                                              Text="{Binding NewChannelAppProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                    <Button Style="{StaticResource StudioPrimaryButtonStyle}" Height="36" Content="{DynamicResource Ch_CreateBtn}" Command="{Binding CreateNewChannelCommand}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="36" Content="{DynamicResource Ch_CancelBtn}" Command="{Binding ToggleNewChannelCreatorCommand}" />
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <!-- Horizontal Scrollable Dynamic Channel Strips -->
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding DynamicChannels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="180"
                                                Margin="0,0,12,0"
                                                Padding="14"
                                                CornerRadius="12"
                                                Background="#CC111827"
                                                BorderBrush="#20FFFFFF"
                                                BorderThickness="1"
                                                AllowDrop="True"
                                                DragOver="OnDynamicChannelDragOver"
                                                Drop="OnDynamicChannelDrop">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Height="3"
                                                        CornerRadius="2"
                                                        Margin="0,0,0,8"
                                                        Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}" />

                                                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                                    <Button DockPanel.Dock="Right"
                                                            Style="{StaticResource StudioChipButtonStyle}"
                                                            Content="×"
                                                            Command="{Binding DataContext.DeleteChannelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{DynamicResource Ch_DeleteTooltip}"
                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            FontSize="13"
                                                            Foreground="#CBD5E1"
                                                            Background="#1E293B"
                                                            BorderBrush="#334155" />
                                                    <Button DockPanel.Dock="Right"
                                                            Style="{StaticResource StudioChipButtonStyle}"
                                                            Content="FX"
                                                            Command="{Binding DataContext.OpenChannelDrawerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{DynamicResource Channel_FxTooltip}"
                                                            Height="24"
                                                            Padding="8,0"
                                                            Margin="0,0,4,0"
                                                            FontSize="10.5"
                                                            FontWeight="Bold"
                                                            Foreground="#7DD3FC"
                                                            Background="#1E3A5F"
                                                            BorderBrush="#38BDF8" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F8FAFC"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>

                                                <ItemsControl Grid.Row="2" ItemsSource="{Binding BoundApps}" Margin="0,0,0,8">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,4,4" Padding="6,2" CornerRadius="4" Background="#2638BDF8">
                                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="#BAE6FD" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>

                                                    <controls:StudioFaderControl Grid.Column="0"
                                                                                 Value="{Binding Volume, Mode=TwoWay}"
                                                                                 AccentColor="{Binding Color}"
                                                                                 IsMuted="{Binding Muted}" />

                                                    <controls:VuMeterControl Grid.Column="1"
                                                                             PeakLeft="{Binding PeakLeft}"
                                                                             PeakRight="{Binding PeakRight}"
                                                                             RmsLeft="{Binding RmsLeft}"
                                                                             RmsRight="{Binding RmsRight}"
                                                                             IsMuted="{Binding Muted}"
                                                                             IsClipping="{Binding IsClipping}" />
                                                </Grid>

                                                <TextBlock Grid.Row="4"
                                                           Text="{Binding VolumeDbText}"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#CBD5E1"
                                                           Margin="0,0,0,8" />

                                                <UniformGrid Grid.Row="5" Rows="1" Columns="2">
                                                    <ToggleButton Style="{StaticResource StudioMuteToggleButtonStyle}"
                                                                  Content="{DynamicResource Channel_MuteShort}"
                                                                  IsChecked="{Binding Muted, Mode=TwoWay}"
                                                                  ToolTip="{DynamicResource Channel_MuteTooltip}"
                                                                  Margin="0,0,3,0"
                                                                  Height="28"
                                                                  FontWeight="Bold" />
                                                    <ToggleButton Style="{StaticResource StudioToggleButtonStyle}"
                                                                  Content="{DynamicResource Channel_SoloShort}"
                                                                  IsChecked="{Binding Solo, Mode=TwoWay}"
                                                                  ToolTip="{DynamicResource Channel_SoloTooltip}"
                                                                  Margin="3,0,0,0"
                                                                  Height="28"
                                                                  FontWeight="Bold" />
                                                </UniformGrid>

                                                <!-- A1/A2/B1/B2 Send Pills (ONLY visible in Advanced Streamer Mode) -->
                                                <UniformGrid Grid.Row="6"
                                                             Rows="2"
                                                             Columns="2"
                                                             Margin="0,8,0,0"
                                                             Visibility="{Binding DataContext.IsStreamerMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ToggleButton Style="{StaticResource StudioToggleButtonStyle}"
                                                                  Content="{DynamicResource Ch_SendA1}"
                                                                  IsChecked="{Binding SendA1, Mode=TwoWay}"
                                                                  IsEnabled="{Binding EchoLockedA1A2, Converter={StaticResource InverseBoolConverter}}"
                                                                  ToolTip="{DynamicResource Ch_EchoLockTooltip}"
                                                                  Margin="0,0,2,2"
                                                                  Height="24"
                                                                  Padding="4,2"
                                                                  FontSize="10"
                                                                  FontWeight="Bold" />
                                                    <ToggleButton Style="{StaticResource StudioToggleButtonStyle}"
                                                                  Content="{DynamicResource Ch_SendA2}"
                                                                  IsChecked="{Binding SendA2, Mode=TwoWay}"
                                                                  IsEnabled="{Binding EchoLockedA1A2, Converter={StaticResource InverseBoolConverter}}"
                                                                  ToolTip="{DynamicResource Ch_EchoLockTooltip}"
                                                                  Margin="2,0,0,2"
                                                                  Height="24"
                                                                  Padding="4,2"
                                                                  FontSize="10"
                                                                  FontWeight="Bold" />
                                                    <ToggleButton Style="{StaticResource StudioToggleButtonStyle}"
                                                                  Content="{DynamicResource Ch_SendB1}"
                                                                  IsChecked="{Binding SendB1, Mode=TwoWay}"
                                                                  Margin="0,2,2,0"
                                                                  Height="24"
                                                                  Padding="4,2"
                                                                  FontSize="10"
                                                                  FontWeight="Bold" />
                                                    <ToggleButton Style="{StaticResource StudioToggleButtonStyle}"
                                                                  Content="{DynamicResource Ch_SendB2}"
                                                                  IsChecked="{Binding SendB2, Mode=TwoWay}"
                                                                  Margin="2,2,0,0"
                                                                  Height="24"
                                                                  Padding="4,2"
                                                                  FontSize="10"
                                                                  FontWeight="Bold" />
                                                </UniformGrid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Slide-Over Channel DSP Drawer (does not crush channels at 1080px) -->
                <Border Width="264"
                        HorizontalAlignment="Right"
                        Panel.ZIndex="10"
                        CornerRadius="14"
                        Padding="18"
                        Background="#F20B0F17"
                        BorderBrush="#5538BDF8"
                        BorderThickness="1"
                        Visibility="{Binding IsChannelDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedDrawerChannel}">
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource StudioSecondaryButtonStyle}"
                                        Content="{DynamicResource Drawer_Close}"
                                        Command="{Binding DataContext.CloseChannelDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        MinHeight="28"
                                        Padding="10,4"
                                        FontSize="11.5" />
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <controls:RotaryKnobControl Value="{Binding Pan, Mode=TwoWay}" Minimum="-1" Maximum="1" DefaultValue="0" Label="{DynamicResource Drawer_Pan}" AccentColor="#38BDF8" Height="78" />
                                <controls:RotaryKnobControl Value="{Binding EqLowDb, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqLow}" AccentColor="#A855F7" Height="78" />
                                <controls:RotaryKnobControl Value="{Binding EqMidDb, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqMid}" AccentColor="#A855F7" Height="78" />
                                <controls:RotaryKnobControl Value="{Binding EqHighDb, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqHigh}" AccentColor="#A855F7" Height="78" />
                                <controls:RotaryKnobControl Value="{Binding CompThresholdDb, Mode=TwoWay}" Minimum="-45" Maximum="0" DefaultValue="-18" Unit="dB" Label="{DynamicResource Drawer_CompShort}" AccentColor="#F59E0B" Height="78" />
                                <controls:RotaryKnobControl Value="{Binding DuckDepthDb, Mode=TwoWay}" Minimum="-30" Maximum="0" DefaultValue="-12" Unit="dB" Label="{DynamicResource Drawer_DuckShort}" AccentColor="#EC4899" Height="78" />
                            </UniformGrid>

                            <TextBlock Text="{DynamicResource Drawer_DuckSource}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DuckSourceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                                    Content="{DynamicResource Drawer_SpectrumFocus}"
                                    Command="{Binding DataContext.FocusSpectrumOnChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Right Column: Clean 2-Card Hardware I/O (or A1/A2/B1/B2 in Streamer Mode) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Default Clean Mode: Output (Speaker/Headphones) + Input (Microphone) -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsStreamerMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Card 1: Output -->
                        <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14" DataContext="{Binding PrimaryOutputBus}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right"
                                                      Style="{StaticResource IconToggleButtonStyle}"
                                                      IsChecked="{Binding Muted, Mode=TwoWay}"
                                                      ToolTip="{DynamicResource Channel_MuteTooltip}">
                                            <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource Icon_Speaker}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource Icon_SpeakerMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </ToggleButton>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.RefreshDevicesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="{DynamicResource Io_RefreshDevicesTooltip}"
                                                Margin="0,0,6,0">
                                            <Path Data="{StaticResource Icon_Refresh}" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                                        </Button>
                                        <TextBlock Text="{DynamicResource Mixer_OutputCardTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Mixer_OutputCardDesc}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    <ComboBox ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding DeviceId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              ItemTemplate="{StaticResource DeviceComboItemTemplate}"
                                              Margin="0,8,0,6" />
                                    <TextBlock Text="{DynamicResource Mixer_NoOutputDevices}"
                                               FontSize="11"
                                               Foreground="#F59E0B"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding DataContext.HasNoOutputDevices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeDbText}" FontFamily="Consolas" FontSize="11" Foreground="#CBD5E1" Width="54" TextAlignment="Right" VerticalAlignment="Center" />
                                        <Slider Minimum="0" Maximum="1.5" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                                <controls:VuMeterControl Grid.Column="1" PeakLeft="{Binding PeakLeft}" PeakRight="{Binding PeakRight}" RmsLeft="{Binding RmsLeft}" RmsRight="{Binding RmsRight}" IsMuted="{Binding Muted}" IsClipping="{Binding IsClipping}" />
                            </Grid>
                        </Border>

                        <!-- Card 2: Input (Microphone) -->
                        <Border Style="{StaticResource StudioCardStyle}" DataContext="{Binding PrimaryMicChannel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right"
                                                      Style="{StaticResource IconToggleButtonStyle}"
                                                      IsChecked="{Binding Muted, Mode=TwoWay}"
                                                      ToolTip="{DynamicResource Channel_MuteTooltip}">
                                            <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource Icon_Mic}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource Icon_MicMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </ToggleButton>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.RefreshDevicesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="{DynamicResource Io_RefreshDevicesTooltip}"
                                                Margin="0,0,6,0">
                                            <Path Data="{StaticResource Icon_Refresh}" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                                        </Button>
                                        <TextBlock Text="{DynamicResource Mixer_InputCardTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Mixer_InputCardDesc}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                    <ComboBox ItemsSource="{Binding DataContext.InputDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding DeviceId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              ItemTemplate="{StaticResource DeviceComboItemTemplate}"
                                              Margin="0,8,0,6" />
                                    <TextBlock Text="{DynamicResource Mixer_NoInputDevices}"
                                               FontSize="11"
                                               Foreground="#F59E0B"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding DataContext.HasNoInputDevices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <DockPanel Margin="0,4,0,10">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeDbText}" FontFamily="Consolas" FontSize="11" Foreground="#CBD5E1" Width="54" TextAlignment="Right" VerticalAlignment="Center" />
                                        <Slider Minimum="0" Maximum="1.5" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                                            Content="{DynamicResource Mixer_OpenMicStudio}"
                                            Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="1"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <controls:VuMeterControl Grid.Column="1" PeakLeft="{Binding PeakLeft}" PeakRight="{Binding PeakRight}" RmsLeft="{Binding RmsLeft}" RmsRight="{Binding RmsRight}" IsMuted="{Binding Muted}" IsClipping="{Binding IsClipping}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Advanced Streamer Mode: Full A1 / A2 / B1 / B2 Output Buses -->
                <Border Grid.Row="0"
                        Style="{StaticResource StudioCardStyle}"
                        Visibility="{Binding IsStreamerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OutputBuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="10" CornerRadius="10" Background="#CC111827" BorderBrush="#22FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <DockPanel>
                                                    <ToggleButton DockPanel.Dock="Right"
                                                                  Style="{StaticResource StudioMuteToggleButtonStyle}"
                                                                  Content="{DynamicResource Channel_MuteShort}"
                                                                  IsChecked="{Binding Muted, Mode=TwoWay}"
                                                                  Width="28"
                                                                  Height="24"
                                                                  Padding="0"
                                                                  FontWeight="Bold" />
                                                    <TextBlock FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                                                <Binding Path="RoleNameKey" />
                                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DockPanel>
                                                <ComboBox ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedValue="{Binding DeviceId, Mode=TwoWay}"
                                                          SelectedValuePath="Id"
                                                          ItemTemplate="{StaticResource DeviceComboItemTemplate}"
                                                          Margin="0,8,0,8" />
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeDbText}" FontFamily="Consolas" FontSize="10" Foreground="#94A3B8" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <Slider Minimum="0" Maximum="1.5" Value="{Binding Volume, Mode=TwoWay}" />
                                                </DockPanel>
                                            </StackPanel>
                                            <controls:VuMeterControl Grid.Column="1" PeakLeft="{Binding PeakLeft}" PeakRight="{Binding PeakRight}" RmsLeft="{Binding RmsLeft}" RmsRight="{Binding RmsRight}" IsMuted="{Binding Muted}" IsClipping="{Binding IsClipping}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Subtle Streamer Multi-Output Mode Toggle -->
                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,10" CornerRadius="10" Background="#CC0F1522" BorderBrush="#2A364D" BorderThickness="1">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsStreamerMode, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Mixer_StreamerMode}" FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
