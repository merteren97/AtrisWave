<UserControl x:Class="AtrisWave.UI.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AtrisWave.UI.Controls"
             xmlns:services="clr-namespace:AtrisWave.UI.Services">
    <UserControl.Resources>
        <DataTemplate x:Key="DeviceComboItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Margin="0,0,6,0"
                        Padding="5,1"
                        CornerRadius="4"
                        Background="#3306B6D4"
                        Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource Io_VirtualBadge}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#22D3EE" />
                </Border>
                <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Category Icon Path style driven by DynamicChannelModel.IconKind -->
        <Style x:Key="ChannelCategoryIconStyle" TargetType="Path">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Data" Value="{StaticResource Icon_Sliders}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconKind}" Value="System">
                    <Setter Property="Data" Value="{StaticResource Icon_Mixer}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="Game">
                    <Setter Property="Data" Value="{StaticResource Icon_Gamepad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="Chat">
                    <Setter Property="Data" Value="{StaticResource Icon_Chat}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="Media">
                    <Setter Property="Data" Value="{StaticResource Icon_Music}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="Aux">
                    <Setter Property="Data" Value="{StaticResource Icon_Aux}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="Mic">
                    <Setter Property="Data" Value="{StaticResource Icon_Mic}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Recessed drop tray container at the bottom of each strip -->
        <Style x:Key="AppTrayBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#0A0F1A" />
            <Setter Property="BorderBrush" Value="#243045" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinHeight" Value="118" />
            <Setter Property="MaxHeight" Value="148" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Health Warning Banner (1-Click Auto-Setup) -->
        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,8"
                CornerRadius="10"
                Background="#26F59E0B"
                BorderBrush="#66F59E0B"
                BorderThickness="1"
                Visibility="{Binding IsHealthWarning, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource StudioPrimaryButtonStyle}"
                        Content="{DynamicResource Health_AutoSetup}"
                        Command="{Binding AutoSetupDefaultsCommand}"
                        Margin="12,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HealthWarningMessage}"
                               Foreground="#FDE68A"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error / IPC Diagnostic Banner -->
        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="12,8"
                CornerRadius="10"
                Background="#26EF4444"
                BorderBrush="#66EF4444"
                BorderThickness="1"
                Visibility="{Binding HasLastError, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource StudioSecondaryButtonStyle}"
                        Content="{DynamicResource Io_RefreshDevices}"
                        Command="{Binding RefreshDevicesCommand}"
                        Margin="12,0,0,0" />
                <TextBlock Text="{Binding LastErrorMessage}"
                           Foreground="#FCA5A5"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Compact Console Header Bar -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}"
                              IsChecked="{Binding IsStreamerMode, Mode=TwoWay}"
                              Height="32"
                              Padding="10,0"
                              Margin="0,0,8,0"
                              ToolTip="{DynamicResource Mixer_StreamerMode}">
                    <TextBlock Text="{DynamicResource Mixer_StreamerShort}" FontSize="11.5" FontWeight="SemiBold" />
                </ToggleButton>
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{Binding RefreshDevicesCommand}"
                        ToolTip="{DynamicResource Io_RefreshDevicesTooltip}"
                        Width="32"
                        Height="32"
                        Margin="0,0,8,0">
                    <Path Data="{StaticResource Icon_Refresh}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                </Button>
                <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                        Command="{Binding ToggleNewChannelCreatorCommand}"
                        Height="32"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon_Plus}" Width="12" Height="12" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="2" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Ch_AddChannel}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Mixer_SectionTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0"
                            Padding="8,2"
                            CornerRadius="999"
                            Background="#162235"
                            BorderBrush="#2C3E58"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding IsDriverInstalled, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                        <Binding Path="DriverStatusKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="{DynamicResource Mixer_ConsoleSubtitle}" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Inline New Custom Channel Creator -->
        <Border Grid.Row="3"
                Margin="0,0,0,10"
                Padding="12"
                CornerRadius="10"
                Background="#131926"
                BorderBrush="#4438BDF8"
                BorderThickness="1"
                Visibility="{Binding IsNewChannelCreatorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,10,4">
                    <TextBlock Text="{DynamicResource Ch_NewNameLabel}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Width="150" Height="34" Text="{Binding NewChannelName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,10,4">
                    <TextBlock Text="{DynamicResource Ch_SourceAppGroup}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <ComboBox Width="150" Height="34" SelectedIndex="{Binding NewChannelSourceIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{DynamicResource Ch_SourceAppGroup}" />
                        <ComboBoxItem Content="{DynamicResource Ch_SourceMic}" />
                        <ComboBoxItem Content="{DynamicResource Ch_SourceLoopback}" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,10,4">
                    <TextBlock Text="{DynamicResource Ch_BindAppLabel}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <ComboBox Width="160"
                              Height="34"
                              IsEditable="True"
                              ItemsSource="{Binding UnroutedRenderApps}"
                              DisplayMemberPath="AppName"
                              Text="{Binding NewChannelAppProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <Button Style="{StaticResource StudioPrimaryButtonStyle}" Height="34" Content="{DynamicResource Ch_CreateBtn}" Command="{Binding CreateNewChannelCommand}" Margin="0,0,6,0" />
                    <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="34" Content="{DynamicResource Ch_CancelBtn}" Command="{Binding ToggleNewChannelCreatorCommand}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Main Sonar-Inspired Console Workspace + Optional Streamer Bus Drawer + FX Drawer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Unified Horizontal Mixer Console -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- COLUMN 1: MASTER / SYSTEM + Output Device + "Apps to be routed" -->
                    <Border Grid.Column="0"
                            Width="226"
                            Margin="0,0,10,0"
                            Padding="12"
                            CornerRadius="14"
                            Background="#CC0F1624"
                            BorderBrush="#306366F1"
                            BorderThickness="1"
                            AllowDrop="True"
                            DragEnter="OnChannelDragEnter"
                            DragOver="OnChannelDragOver"
                            DragLeave="OnChannelDragLeave"
                            Drop="OnSystemChannelDrop"
                            Tag="System">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Indigo Accent Top Line -->
                            <Border Grid.Row="0" Height="3" CornerRadius="2" Margin="0,0,0,10" Background="#6366F1" />

                            <!-- Master Header -->
                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource StudioChipButtonStyle}"
                                        Content="FX"
                                        Command="{Binding OpenChannelDrawerCommand}"
                                        CommandParameter="{Binding SystemChannel}"
                                        ToolTip="{DynamicResource Channel_FxTooltip}"
                                        Height="24"
                                        Padding="8,0"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="#A5B4FC"
                                        Background="#266366F1"
                                        BorderBrush="#556366F1" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#266366F1" Margin="0,0,8,0">
                                        <Path Data="{StaticResource Icon_Mixer}" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="#A5B4FC" StrokeThickness="1.9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Channel_Master}" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC" />
                                        <TextBlock Text="AtrisWave System" FontSize="10" Foreground="#818CF8" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- Inline Output Device Selector (A1 Physical Headphones/Speakers) -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,10" DataContext="{Binding PrimaryOutputBus}">
                                <TextBlock Text="{DynamicResource Mixer_PlaybackLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding DeviceId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          ItemTemplate="{StaticResource DeviceComboItemTemplate}"
                                          Height="32" />
                                <TextBlock Text="{DynamicResource Mixer_NoOutputDevices}"
                                           FontSize="10"
                                           Foreground="#F59E0B"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding DataContext.HasNoOutputDevices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Master Fader + Live Stereo VU Meter -->
                            <Grid Grid.Row="3" Margin="0,0,0,6" DataContext="{Binding PrimaryOutputBus}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <controls:StudioFaderControl Grid.Column="0"
                                                             Value="{Binding Volume, Mode=TwoWay}"
                                                             AccentColor="#6366F1"
                                                             IsMuted="{Binding Muted}" />
                                <controls:VuMeterControl Grid.Column="1"
                                                         PeakLeft="{Binding PeakLeft}"
                                                         PeakRight="{Binding PeakRight}"
                                                         RmsLeft="{Binding RmsLeft}"
                                                         RmsRight="{Binding RmsRight}"
                                                         IsMuted="{Binding Muted}"
                                                         IsClipping="{Binding IsClipping}" />
                            </Grid>

                            <!-- Master dB Readout -->
                            <TextBlock Grid.Row="4"
                                       DataContext="{Binding PrimaryOutputBus}"
                                       Text="{Binding VolumeDbText}"
                                       HorizontalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="#CBD5E1"
                                       Margin="0,0,0,6" />

                            <!-- Master Mute Button -->
                            <ToggleButton Grid.Row="5"
                                          DataContext="{Binding PrimaryOutputBus}"
                                          Style="{StaticResource StudioMuteToggleButtonStyle}"
                                          IsChecked="{Binding Muted, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Channel_MuteTooltip}"
                                          Height="30"
                                          Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource Icon_Speaker}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Muted}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource Icon_SpeakerMuted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{DynamicResource Channel_MuteShort}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <!-- Bottom Drop Tray: "Apps to be routed" (ONLY active playback apps) -->
                            <Border Grid.Row="6" Style="{StaticResource AppTrayBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Mixer_AppsToRoute}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#94A3B8" />
                                    </DockPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Mixer_NoActiveApps}"
                                                       FontSize="10.5"
                                                       Foreground="#475569"
                                                       TextWrapping="Wrap"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Visibility="{Binding HasNoUnroutedRenderApps, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ItemsControl ItemsSource="{Binding UnroutedRenderApps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,4"
                                                                Padding="8,5"
                                                                CornerRadius="7"
                                                                Background="#182234"
                                                                BorderBrush="#2C3E58"
                                                                BorderThickness="1"
                                                                Cursor="Hand"
                                                                ToolTip="{Binding AppName}"
                                                                PreviewMouseLeftButtonDown="OnAppChipMouseDown"
                                                                PreviewMouseMove="OnAppChipMouseMove">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="⋮⋮" FontSize="10" Foreground="#475569" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ChipLabel}"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#E2E8F0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- COLUMNS 2..N: VIRTUAL ROUTING CHANNELS (GAME, CHAT, MEDIA, AUX, CUSTOM) + BOTTOM CHATMIX BAR -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0" ItemsSource="{Binding RoutingChannels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="194"
                                            Margin="0,0,10,0"
                                            Padding="12"
                                            CornerRadius="14"
                                            Background="#CC111827"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            AllowDrop="True"
                                            DragEnter="OnChannelDragEnter"
                                            DragOver="OnChannelDragOver"
                                            DragLeave="OnChannelDragLeave"
                                            Drop="OnDynamicChannelDrop">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Channel Color Accent Line -->
                                            <Border Grid.Row="0"
                                                    Height="3"
                                                    CornerRadius="2"
                                                    Margin="0,0,0,10"
                                                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}" />

                                            <!-- Channel Header: Icon + Name + FX + Delete -->
                                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource StudioChipButtonStyle}"
                                                        Content="×"
                                                        Command="{Binding DataContext.DeleteChannelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{DynamicResource Ch_DeleteTooltip}"
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Width="22"
                                                        Height="22"
                                                        Padding="0"
                                                        Margin="4,0,0,0"
                                                        FontSize="12"
                                                        Foreground="#CBD5E1"
                                                        Background="#1E293B"
                                                        BorderBrush="#334155" />
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource StudioChipButtonStyle}"
                                                        Content="FX"
                                                        Command="{Binding DataContext.OpenChannelDrawerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{DynamicResource Channel_FxTooltip}"
                                                        Height="22"
                                                        Padding="7,0"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#7DD3FC"
                                                        Background="#1E3A5F"
                                                        BorderBrush="#38BDF8" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Style="{StaticResource ChannelCategoryIconStyle}"
                                                          Stroke="{Binding Color, Converter={StaticResource HexToBrushConverter}}"
                                                          Margin="0,0,7,0"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               Foreground="#F8FAFC"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Virtual Bus Pill (clickable to inspect Virtual Source / FX) -->
                                            <Button Grid.Row="2"
                                                    Style="{StaticResource StudioSecondaryButtonStyle}"
                                                    Command="{Binding DataContext.OpenChannelDrawerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Height="28"
                                                    MinHeight="28"
                                                    Padding="8,0"
                                                    Margin="0,0,0,10"
                                                    HorizontalContentAlignment="Left"
                                                    Background="#0D1422"
                                                    BorderBrush="#243045">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                             Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}" />
                                                    <TextBlock Text="{Binding VirtualBusLabel}"
                                                               FontSize="10.5"
                                                               Foreground="#CBD5E1"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Vertical Fader + VU Meter -->
                                            <Grid Grid.Row="3" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <controls:StudioFaderControl Grid.Column="0"
                                                                             Value="{Binding Volume, Mode=TwoWay}"
                                                                             AccentColor="{Binding Color}"
                                                                             IsMuted="{Binding Muted}" />
                                                <controls:VuMeterControl Grid.Column="1"
                                                                         PeakLeft="{Binding PeakLeft}"
                                                                         PeakRight="{Binding PeakRight}"
                                                                         RmsLeft="{Binding RmsLeft}"
                                                                         RmsRight="{Binding RmsRight}"
                                                                         IsMuted="{Binding Muted}"
                                                                         IsClipping="{Binding IsClipping}" />
                                            </Grid>

                                            <!-- dB Readout -->
                                            <TextBlock Grid.Row="4"
                                                       Text="{Binding VolumeDbText}"
                                                       HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#CBD5E1"
                                                       Margin="0,0,0,6" />

                                            <!-- Mute / Solo -->
                                            <UniformGrid Grid.Row="5" Rows="1" Columns="2" Margin="0,0,0,8">
                                                <ToggleButton Style="{StaticResource StudioMuteToggleButtonStyle}"
                                                              Content="{DynamicResource Channel_MuteShort}"
                                                              IsChecked="{Binding Muted, Mode=TwoWay}"
                                                              ToolTip="{DynamicResource Channel_MuteTooltip}"
                                                              Margin="0,0,3,0"
                                                              Height="28"
                                                              FontWeight="Bold" />
                                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}"
                                                              Content="{DynamicResource Channel_SoloShort}"
                                                              IsChecked="{Binding Solo, Mode=TwoWay}"
                                                              ToolTip="{DynamicResource Channel_SoloTooltip}"
                                                              Margin="3,0,0,0"
                                                              Height="28"
                                                              FontWeight="Bold" />
                                            </UniformGrid>

                                            <!-- A1/A2/B1/B2 Send Pills (Streamer Mode only) -->
                                            <UniformGrid Grid.Row="6"
                                                         Rows="1"
                                                         Columns="4"
                                                         Margin="0,0,0,8"
                                                         Visibility="{Binding DataContext.IsStreamerMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Ch_SendA1}" IsChecked="{Binding SendA1, Mode=TwoWay}" IsEnabled="{Binding EchoLockedA1A2, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,2,0" Height="22" Padding="2,0" FontSize="9.5" FontWeight="Bold" />
                                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Ch_SendA2}" IsChecked="{Binding SendA2, Mode=TwoWay}" IsEnabled="{Binding EchoLockedA1A2, Converter={StaticResource InverseBoolConverter}}" Margin="1,0" Height="22" Padding="2,0" FontSize="9.5" FontWeight="Bold" />
                                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Ch_SendB1}" IsChecked="{Binding SendB1, Mode=TwoWay}" Margin="1,0" Height="22" Padding="2,0" FontSize="9.5" FontWeight="Bold" />
                                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Ch_SendB2}" IsChecked="{Binding SendB2, Mode=TwoWay}" Margin="2,0,0,0" Height="22" Padding="2,0" FontSize="9.5" FontWeight="Bold" />
                                            </UniformGrid>

                                            <!-- Bottom Drop Tray: Channel's Routed Apps (Draggable Chips) -->
                                            <Border Grid.Row="7" Style="{StaticResource AppTrayBorderStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0"
                                                               Text="{DynamicResource Mixer_Apps}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#94A3B8"
                                                               Margin="0,0,0,6" />
                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                        <Grid>
                                                            <TextBlock Text="{DynamicResource Mixer_DragAppsHint}"
                                                                       FontSize="10.5"
                                                                       Foreground="#475569"
                                                                       TextWrapping="Wrap"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       TextAlignment="Center"
                                                                       Visibility="{Binding HasNoBoundApps, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <ItemsControl ItemsSource="{Binding BoundAppChips}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,0,4"
                                                                                Padding="7,4"
                                                                                CornerRadius="7"
                                                                                Background="#192438"
                                                                                BorderBrush="#2E4160"
                                                                                BorderThickness="1"
                                                                                Cursor="Hand"
                                                                                ToolTip="{Binding ProcessName}"
                                                                                PreviewMouseLeftButtonDown="OnAppChipMouseDown"
                                                                                PreviewMouseMove="OnAppChipMouseMove">
                                                                            <DockPanel>
                                                                                <Button DockPanel.Dock="Right"
                                                                                        Style="{StaticResource StudioChipButtonStyle}"
                                                                                        Content="×"
                                                                                        Command="{Binding DataContext.RemoveBoundAppChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        ToolTip="{DynamicResource Mixer_UnbindAppTooltip}"
                                                                                        Width="18"
                                                                                        Height="18"
                                                                                        Padding="0"
                                                                                        Margin="4,0,0,0"
                                                                                        FontSize="11"
                                                                                        Foreground="#94A3B8"
                                                                                        Background="Transparent"
                                                                                        BorderBrush="Transparent" />
                                                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                    <Ellipse.Style>
                                                                                        <Style TargetType="Ellipse">
                                                                                            <Setter Property="Fill" Value="#475569" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                                                                                    <Setter Property="Fill" Value="#10B981" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Ellipse.Style>
                                                                                </Ellipse>
                                                                                <TextBlock Text="{Binding DisplayLabel}"
                                                                                           FontSize="11.5"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#F1F5F9"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center" />
                                                                            </DockPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- BOTTOM CHATMIX BALANCE SLIDER (Anchored directly under Game & Chat columns) -->
                        <Border Grid.Row="1"
                                Margin="0,10,10,0"
                                Padding="14,9"
                                CornerRadius="12"
                                Background="#CC0F1624"
                                BorderBrush="#2638BDF8"
                                BorderThickness="1"
                                ToolTip="{DynamicResource Mixer_ChatMixResetTooltip}"
                                MouseLeftButtonDown="OnChatMixBarMouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Game Left Icon -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon_Gamepad}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="#10B981" StrokeThickness="1.9" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Mixer_ChatMix}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- ChatMix Balance Slider (-1 = Game, 0 = Center, +1 = Chat) -->
                                <Slider Grid.Column="1"
                                        Minimum="-1"
                                        Maximum="1"
                                        SmallChange="0.05"
                                        LargeChange="0.1"
                                        TickFrequency="1"
                                        TickPlacement="None"
                                        Value="{Binding ChatMixBalance, Mode=TwoWay}"
                                        VerticalAlignment="Center" />

                                <!-- Chat Right Icon + Live Readout -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0">
                                    <Path Data="{StaticResource Icon_Chat}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="#38BDF8" StrokeThickness="1.9" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ChatMixDisplayText}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#CBD5E1"
                                               MinWidth="68"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Style="{StaticResource StudioChipButtonStyle}"
                                        Content="{DynamicResource Mixer_Reset}"
                                        Command="{Binding ResetChatMixCommand}"
                                        Height="24"
                                        Padding="8,0"
                                        FontSize="10.5" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- COLUMN 3: MIC CHANNEL + Inline Mic Selector + Active Mic-Using Apps Tray -->
                    <Border Grid.Column="2"
                            Width="226"
                            Margin="0,0,10,0"
                            Padding="12"
                            CornerRadius="14"
                            Background="#CC111827"
                            BorderBrush="#33F59E0B"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Amber Accent Top Line -->
                            <Border Grid.Row="0" Height="3" CornerRadius="2" Margin="0,0,0,10" Background="#F59E0B" />

                            <!-- Mic Header -->
                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource StudioChipButtonStyle}"
                                        Content="DSP"
                                        Command="{Binding SelectNavCommand}"
                                        CommandParameter="1"
                                        ToolTip="{DynamicResource Mixer_OpenMicStudio}"
                                        Height="24"
                                        Padding="8,0"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="#FCD34D"
                                        Background="#26F59E0B"
                                        BorderBrush="#55F59E0B" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#26F59E0B" Margin="0,0,8,0">
                                        <Path Data="{StaticResource Icon_Mic}" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="#FBBF24" StrokeThickness="1.9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Channel_Microphone}" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC" />
                                        <TextBlock Text="AtrisWave Mic" FontSize="10" Foreground="#F59E0B" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- Inline Microphone Device Selector -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,10" DataContext="{Binding PrimaryMicChannel}">
                                <TextBlock Text="{DynamicResource Mixer_MicInputLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding DataContext.InputDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding DeviceId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          ItemTemplate="{StaticResource DeviceComboItemTemplate}"
                                          Height="32" />
                                <TextBlock Text="{DynamicResource Mixer_NoInputDevices}"
                                           FontSize="10"
                                           Foreground="#F59E0B"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding DataContext.HasNoInputDevices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Mic Fader + VU Meter -->
                            <Grid Grid.Row="3" Margin="0,0,0,6" DataContext="{Binding PrimaryMicChannel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <controls:StudioFaderControl Grid.Column="0"
                                                             Value="{Binding Volume, Mode=TwoWay}"
                                                             AccentColor="#F59E0B"
                                                             IsMuted="{Binding Muted}" />
                                <controls:VuMeterControl Grid.Column="1"
                                                         PeakLeft="{Binding PeakLeft}"
                                                         PeakRight="{Binding PeakRight}"
                                                         RmsLeft="{Binding RmsLeft}"
                                                         RmsRight="{Binding RmsRight}"
                                                         IsMuted="{Binding Muted}"
                                                         IsClipping="{Binding IsClipping}" />
                            </Grid>

                            <!-- Mic dB Readout -->
                            <TextBlock Grid.Row="4"
                                       DataContext="{Binding PrimaryMicChannel}"
                                       Text="{Binding VolumeDbText}"
                                       HorizontalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="#CBD5E1"
                                       Margin="0,0,0,6" />

                            <!-- Mic Mute Toggle -->
                            <ToggleButton Grid.Row="5"
                                          DataContext="{Binding PrimaryMicChannel}"
                                          Style="{StaticResource StudioMuteToggleButtonStyle}"
                                          IsChecked="{Binding Muted, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Channel_MuteTooltip}"
                                          Height="30"
                                          Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource Icon_Mic}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Muted}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource Icon_MicMuted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{DynamicResource Channel_MuteShort}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <!-- Bottom Tray: Apps Currently Using Microphone (Active Capture Sessions) -->
                            <Border Grid.Row="6" Style="{StaticResource AppTrayBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Fill="#F59E0B" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Mixer_Apps}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#94A3B8" />
                                    </DockPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Mixer_NoMicApps}"
                                                       FontSize="10.5"
                                                       Foreground="#475569"
                                                       TextWrapping="Wrap"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Visibility="{Binding HasNoActiveCaptureApps, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ItemsControl ItemsSource="{Binding ActiveCaptureApps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,4"
                                                                Padding="8,5"
                                                                CornerRadius="7"
                                                                Background="#1C1A17"
                                                                BorderBrush="#44F59E0B"
                                                                BorderThickness="1"
                                                                ToolTip="{Binding AppName}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ChipLabel}"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#FDE68A"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- COLUMN 4: QUICK-ADD VIRTUAL CHANNELS RAIL (+ Media / + Aux / + Custom) -->
                    <StackPanel Grid.Column="3" Width="124" VerticalAlignment="Top">
                        <Button Style="{StaticResource StudioSecondaryButtonStyle}"
                                Command="{Binding QuickAddMediaChannelCommand}"
                                Visibility="{Binding CanQuickAddMedia, Converter={StaticResource BoolToVisibilityConverter}}"
                                Height="72"
                                Margin="0,0,0,10"
                                Padding="10"
                                Background="#131926"
                                BorderBrush="#33A855F7">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource Icon_Music}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="#C084FC" StrokeThickness="1.8" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="{DynamicResource Mixer_AddMedia}" FontSize="11.5" FontWeight="SemiBold" Foreground="#E9D5FF" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource StudioSecondaryButtonStyle}"
                                Command="{Binding QuickAddAuxChannelCommand}"
                                Visibility="{Binding CanQuickAddAux, Converter={StaticResource BoolToVisibilityConverter}}"
                                Height="72"
                                Margin="0,0,0,10"
                                Padding="10"
                                Background="#131926"
                                BorderBrush="#33EC4899">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource Icon_Aux}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="#F472B6" StrokeThickness="1.8" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="{DynamicResource Mixer_AddAux}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FBCFE8" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource StudioSecondaryButtonStyle}"
                                Command="{Binding ToggleNewChannelCreatorCommand}"
                                Height="72"
                                Padding="10"
                                Background="#101725"
                                BorderBrush="#334155">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource Icon_Plus}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="#38BDF8" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="{DynamicResource Mixer_AddCustom}" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Advanced Streamer Mode Output Buses Side Panel (A1 / A2 / B1 / B2) -->
            <Border Grid.Column="1"
                    Width="296"
                    Margin="12,0,0,0"
                    Style="{StaticResource StudioCardStyle}"
                    Visibility="{Binding IsStreamerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Bus_SectionTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding OutputBuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="10" CornerRadius="10" Background="#CC111827" BorderBrush="#22FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <DockPanel>
                                                    <ToggleButton DockPanel.Dock="Right"
                                                                  Style="{StaticResource StudioMuteToggleButtonStyle}"
                                                                  Content="{DynamicResource Channel_MuteShort}"
                                                                  IsChecked="{Binding Muted, Mode=TwoWay}"
                                                                  Width="26"
                                                                  Height="22"
                                                                  Padding="0"
                                                                  FontWeight="Bold" />
                                                    <TextBlock FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                                                <Binding Path="RoleNameKey" />
                                                                <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DockPanel>
                                                <ComboBox ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedValue="{Binding DeviceId, Mode=TwoWay}"
                                                          SelectedValuePath="Id"
                                                          ItemTemplate="{StaticResource DeviceComboItemTemplate}"
                                                          Height="30"
                                                          Margin="0,6,0,6" />
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeDbText}" FontFamily="Consolas" FontSize="10.5" Foreground="#CBD5E1" Width="50" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <Slider Minimum="0" Maximum="1.5" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </StackPanel>
                                            <controls:VuMeterControl Grid.Column="1" PeakLeft="{Binding PeakLeft}" PeakRight="{Binding PeakRight}" RmsLeft="{Binding RmsLeft}" RmsRight="{Binding RmsRight}" IsMuted="{Binding Muted}" IsClipping="{Binding IsClipping}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Slide-Over Channel DSP & Virtual Source Drawer -->
            <Border Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Width="272"
                    HorizontalAlignment="Right"
                    Panel.ZIndex="10"
                    CornerRadius="14"
                    Padding="18"
                    Background="#F50B0F17"
                    BorderBrush="#5538BDF8"
                    BorderThickness="1"
                    Visibility="{Binding IsChannelDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedDrawerChannel}">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource StudioSecondaryButtonStyle}"
                                    Content="{DynamicResource Drawer_Close}"
                                    Command="{Binding DataContext.CloseChannelDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    MinHeight="28"
                                    Padding="10,4"
                                    FontSize="11.5" />
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <controls:RotaryKnobControl Value="{Binding Pan, Mode=TwoWay}" Minimum="-1" Maximum="1" DefaultValue="0" Label="{DynamicResource Drawer_Pan}" AccentColor="#38BDF8" Height="78" />
                            <controls:RotaryKnobControl Value="{Binding EqLowDb, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqLow}" AccentColor="#A855F7" Height="78" />
                            <controls:RotaryKnobControl Value="{Binding EqMidDb, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqMid}" AccentColor="#A855F7" Height="78" />
                            <controls:RotaryKnobControl Value="{Binding EqHighDb, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqHigh}" AccentColor="#A855F7" Height="78" />
                            <controls:RotaryKnobControl Value="{Binding CompThresholdDb, Mode=TwoWay}" Minimum="-45" Maximum="0" DefaultValue="-18" Unit="dB" Label="{DynamicResource Drawer_CompShort}" AccentColor="#F59E0B" Height="78" />
                            <controls:RotaryKnobControl Value="{Binding DuckDepthDb, Mode=TwoWay}" Minimum="-30" Maximum="0" DefaultValue="-12" Unit="dB" Label="{DynamicResource Drawer_DuckShort}" AccentColor="#EC4899" Height="78" />
                        </UniformGrid>

                        <TextBlock Text="{DynamicResource Drawer_VirtualSource}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedValue="{Binding DeviceId, Mode=TwoWay}"
                                  SelectedValuePath="Id"
                                  ItemTemplate="{StaticResource DeviceComboItemTemplate}"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="{DynamicResource Drawer_DuckSource}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DuckSourceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                                Content="{DynamicResource Drawer_SpectrumFocus}"
                                Command="{Binding DataContext.FocusSpectrumOnChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
