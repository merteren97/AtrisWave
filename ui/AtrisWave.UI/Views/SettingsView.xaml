<UserControl x:Class="AtrisWave.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:services="clr-namespace:AtrisWave.UI.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Language, Windows Startup & Tray, Engine Diagnostics, Plugin Sandbox -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Title}" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,12" />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource StudioPrimaryButtonStyle}"
                                    Content="{DynamicResource Lang_ToggleLabel}"
                                    Command="{Binding ToggleLanguageCommand}" />
                            <TextBlock Text="{DynamicResource Settings_Language}" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsStreamerMode, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Mixer_StreamerMode}" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Windows Startup & System Tray Card -->
                <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_StartupTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <DockPanel Margin="0,0,0,12">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoStartEngineOnLogon, Mode=TwoWay}" VerticalAlignment="Center" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Settings_AutoStartEngine}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Settings_AutoStartEngineDesc}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,12">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoStartAppOnLogon, Mode=TwoWay}" VerticalAlignment="Center" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Settings_AutoStartApp}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Settings_AutoStartAppDesc}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,12">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" VerticalAlignment="Center" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Settings_StartMinimized}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Settings_StartMinimizedDesc}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding KeepEngineRunningOnExit, Mode=TwoWay}" VerticalAlignment="Center" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Settings_KeepEngineRunning}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Settings_KeepEngineRunningDesc}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Engine Daemon & Diagnostics Card -->
                <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_EngineTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" Fill="{Binding IsEngineConnected, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                            <TextBlock Text="{Binding EngineStatusBadgeText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EngineDiagnosticsText}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Margin="0,0,0,10"
                                Padding="10,7"
                                CornerRadius="8"
                                Background="#24EF4444"
                                BorderBrush="#55EF4444"
                                BorderThickness="1"
                                Visibility="{Binding HasLastError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LastErrorMessage}" FontSize="11.5" Foreground="#FCA5A5" TextWrapping="Wrap" />
                        </Border>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource StudioPrimaryButtonStyle}" Command="{Binding LaunchOrStopEngineCommand}" Margin="0,0,8,6">
                                <Button.Content>
                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                        <Binding Path="EngineActionKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </Button.Content>
                            </Button>
                            <Button Style="{StaticResource StudioSecondaryButtonStyle}" Content="{DynamicResource Io_RestartEngine}" Command="{Binding RestartEngineCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource StudioSecondaryButtonStyle}" Content="{DynamicResource Status_PingEngine}" Command="{Binding PingEngineCommand}" Margin="0,0,10,6" />
                            <TextBlock Text="{Binding LastPingMessage}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Out-of-Process Plugin Sandbox Card -->
                <Border Style="{StaticResource StudioCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource StudioPrimaryButtonStyle}"
                                    Content="{DynamicResource Pro_ScanPlugins}"
                                    Command="{Binding ScanPluginsCommand}"
                                    Margin="12,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Pro_SandboxTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                <TextBlock Text="{DynamicResource Pro_SandboxDesc}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Margin="0,0,0,10" Padding="10,6" CornerRadius="6" Background="#2210B981" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Pro_SandboxBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                        </Border>

                        <ListBox Grid.Row="2" ItemsSource="{Binding DiscoveredPlugins}" Background="#CC111827" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4">
                                        <Border DockPanel.Dock="Right" Padding="6,2" CornerRadius="4" Background="#2638BDF8">
                                            <TextBlock Text="{Binding Format}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2"
                                   Text="{DynamicResource Pro_NoPlugins}"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="20"
                                   Visibility="{Binding HasNoPlugins, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Right Column: Global Hotkeys, Stream Deck JSON-RPC, Check for Updates -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Pro_HotkeysTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource Pro_HotkeysDesc}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Pro_HotkeyMicMute}" FontFamily="Consolas" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource Pro_HotkeySidetone}" FontFamily="Consolas" FontSize="12" Foreground="#CBD5E1" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding RpcServerEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Pro_RpcTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource Pro_RpcDesc}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Pro_RpcEndpoint}" FontFamily="Consolas" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8" />
                        <Border Padding="8,4" CornerRadius="6" Background="#1CFFFFFF" HorizontalAlignment="Left">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                        <Binding Path="RpcStatusKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Update_Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Update_Desc}" FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding CurrentAppVersion, StringFormat=v{0}}" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource StudioSecondaryButtonStyle}" Content="{DynamicResource Update_CheckBtn}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                                    Command="{Binding DownloadAndInstallUpdateCommand}"
                                    Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon_Download}" Width="14" Height="14" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Update_DownloadInstall}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource StudioSecondaryButtonStyle}" Content="{DynamicResource Update_OpenRelease}" Command="{Binding OpenUpdateReleaseCommand}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding UpdateDownloadProgress}"
                                     Foreground="#10B981"
                                     Margin="0,10,0,0"
                                     Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="#38BDF8" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
