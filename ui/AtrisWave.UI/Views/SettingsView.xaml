<UserControl x:Class="AtrisWave.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:services="clr-namespace:AtrisWave.UI.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Language, Engine Diagnostics, Streamer Mode, Plugin Sandbox -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <DockPanel Margin="0,0,0,12">
                            <ui:Button DockPanel.Dock="Right"
                                       Content="{DynamicResource Lang_ToggleLabel}"
                                       Command="{Binding ToggleLanguageCommand}"
                                       Appearance="Primary"
                                       Padding="14,6" />
                            <TextBlock Text="{DynamicResource Settings_Language}" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsStreamerMode, Mode=TwoWay}" />
                            <TextBlock Text="{DynamicResource Mixer_StreamerMode}" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_EngineTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" Fill="{Binding IsEngineConnected, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                        <Binding Path="StatusBadgeKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding SampleRateDisplay}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Command="{Binding LaunchOrStopEngineCommand}" Margin="0,0,8,0" Appearance="Secondary">
                                <ui:Button.Content>
                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                        <Binding Path="EngineActionKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </ui:Button.Content>
                            </ui:Button>
                            <ui:Button Content="{DynamicResource Status_PingEngine}" Command="{Binding PingEngineCommand}" Margin="0,0,10,0" Appearance="Secondary" />
                            <TextBlock Text="{Binding LastPingMessage}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Out-of-Process Plugin Sandbox Card -->
                <Border Style="{StaticResource StudioCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Pro_ScanPlugins}" Command="{Binding ScanPluginsCommand}" Appearance="Primary" Padding="14,7" />
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Pro_SandboxTitle}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Pro_SandboxDesc}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Margin="0,0,0,10" Padding="10,6" CornerRadius="6" Background="#2210B981" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Pro_SandboxBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                        </Border>

                        <ListBox Grid.Row="2" ItemsSource="{Binding DiscoveredPlugins}" Background="#CC111827" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4">
                                        <Border DockPanel.Dock="Right" Padding="6,2" CornerRadius="4" Background="#2638BDF8">
                                            <TextBlock Text="{Binding Format}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Right Column: Global Hotkeys, Stream Deck JSON-RPC, Check for Updates -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}" />
                            <TextBlock Text="{DynamicResource Pro_HotkeysTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource Pro_HotkeysDesc}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Pro_HotkeyMicMute}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource Pro_HotkeySidetone}" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding RpcServerEnabled, Mode=TwoWay}" />
                            <TextBlock Text="{DynamicResource Pro_RpcTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource Pro_RpcDesc}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Pro_RpcEndpoint}" FontFamily="Consolas" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8" />
                        <Border Padding="8,4" CornerRadius="6" Background="#1CFFFFFF" HorizontalAlignment="Left">
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                        <Binding Path="RpcStatusKey" />
                                        <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StudioCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Update_Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource Update_Desc}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{DynamicResource Update_CheckBtn}" Command="{Binding CheckForUpdatesCommand}" Appearance="Primary" Margin="0,0,8,0" />
                            <ui:Button Content="{DynamicResource Update_OpenRelease}" Command="{Binding OpenUpdateReleaseCommand}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}" Appearance="Secondary" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="#38BDF8" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
