<UserControl x:Class="AtrisWave.UI.Views.AppRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:services="clr-namespace:AtrisWave.UI.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Virtual Audio Driver Status Banner & Quick Controls -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="14,10"
                CornerRadius="12"
                Background="#E60F1522"
                BorderBrush="#2A364D"
                BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                                Content="{DynamicResource Driver_SetSystemDefault}"
                                Command="{Binding EnableVirtualSystemDefaultCommand}"
                                Visibility="{Binding IsDriverInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource StudioSecondaryButtonStyle}"
                                Content="{DynamicResource Driver_RestoreDefault}"
                                Command="{Binding RestorePhysicalSystemDefaultCommand}"
                                Visibility="{Binding IsDriverInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                                Content="{DynamicResource Driver_InstallBtn}"
                                Command="{Binding InstallVirtualDriverCommand}"
                                Visibility="{Binding IsDriverInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource StudioSecondaryButtonStyle}"
                                Content="{DynamicResource Driver_RefreshStatus}"
                                Command="{Binding RefreshDriverStatusCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10"
                                 Height="10"
                                 Margin="0,0,10,0"
                                 Fill="{Binding IsDriverInstalled, Converter={StaticResource ConnectionStatusBrushConverter}}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                    <Binding Path="DriverStatusKey" />
                                    <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Quick Discord & OBS Virtual Routing Guide -->
                <Border Margin="0,10,0,0"
                        Padding="10,7"
                        CornerRadius="8"
                        Background="#141C2B"
                        BorderBrush="#263248"
                        BorderThickness="1">
                    <TextBlock Text="{DynamicResource Driver_DiscordObsGuide}"
                               FontSize="11.5"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- One-Click & Drag-and-Drop Virtual Channel Assignment Pills -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="14,12"
                CornerRadius="12"
                Background="#E60F1522"
                BorderBrush="#2A364D"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{DynamicResource Driver_DropHint}"
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           Margin="0,0,0,8" />
                <UniformGrid Rows="1" Columns="4">
                    <Button Style="{StaticResource StudioChipButtonStyle}"
                            Height="36"
                            HorizontalAlignment="Stretch"
                            Content="{DynamicResource Channel_Game}"
                            Command="{Binding AssignSelectedSessionToChannelCommand}"
                            CommandParameter="Game"
                            Tag="Game"
                            AllowDrop="True"
                            DragOver="OnChannelPillDragOver"
                            Drop="OnChannelPillDrop"
                            Margin="0,0,6,0"
                            Background="#3B1D5E"
                            BorderBrush="#A855F7"
                            Foreground="#F3E8FF" />
                    <Button Style="{StaticResource StudioChipButtonStyle}"
                            Height="36"
                            HorizontalAlignment="Stretch"
                            Content="{DynamicResource Channel_Chat}"
                            Command="{Binding AssignSelectedSessionToChannelCommand}"
                            CommandParameter="Chat"
                            Tag="Chat"
                            AllowDrop="True"
                            DragOver="OnChannelPillDragOver"
                            Drop="OnChannelPillDrop"
                            Margin="3,0,3,0"
                            Background="#123C2F"
                            BorderBrush="#10B981"
                            Foreground="#D1FAE5" />
                    <Button Style="{StaticResource StudioChipButtonStyle}"
                            Height="36"
                            HorizontalAlignment="Stretch"
                            Content="{DynamicResource Channel_Media}"
                            Command="{Binding AssignSelectedSessionToChannelCommand}"
                            CommandParameter="Media"
                            Tag="Media"
                            AllowDrop="True"
                            DragOver="OnChannelPillDragOver"
                            Drop="OnChannelPillDrop"
                            Margin="3,0,3,0"
                            Background="#452C0A"
                            BorderBrush="#F59E0B"
                            Foreground="#FEF3C7" />
                    <Button Style="{StaticResource StudioChipButtonStyle}"
                            Height="36"
                            HorizontalAlignment="Stretch"
                            Content="{DynamicResource Channel_Aux}"
                            Command="{Binding AssignSelectedSessionToChannelCommand}"
                            CommandParameter="Aux"
                            Tag="Aux"
                            AllowDrop="True"
                            DragOver="OnChannelPillDragOver"
                            Drop="OnChannelPillDrop"
                            Margin="6,0,0,0"
                            Background="#4A1735"
                            BorderBrush="#EC4899"
                            Foreground="#FCE7F3" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Active Sessions + Persistent Rules Split -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.0*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    CornerRadius="12"
                    Background="#990B0F17"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource StudioPrimaryButtonStyle}"
                                Content="{DynamicResource Routing_RefreshSessions}"
                                Command="{Binding RefreshSessionsCommand}"
                                Margin="12,0,0,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Routing_Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" />
                            <TextBlock Text="{DynamicResource Routing_Subtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AudioSessions}"
                              SelectedItem="{Binding SelectedAudioSession, Mode=TwoWay}"
                              PreviewMouseLeftButtonDown="OnSessionsGridPreviewMouseDown"
                              MouseMove="OnSessionsGridMouseMove"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Routing_ColApp}" Binding="{Binding EffectiveLabel}" IsReadOnly="True" Width="1.6*" />
                            <DataGridTextColumn Header="{DynamicResource Routing_ColPid}" Binding="{Binding Pid}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="{DynamicResource Routing_ColVolume}" Binding="{Binding Volume, StringFormat=P0}" IsReadOnly="True" Width="75" />
                            <DataGridTemplateColumn Header="{DynamicResource Routing_ColTargetDevice}" Width="1.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox MinHeight="30"
                                                  Padding="8,4"
                                                  ItemsSource="{Binding DataContext.OutputDevices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedValue="{Binding TargetDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="OnSessionDeviceSelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Routing_ColLoopback}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:ToggleSwitch IsChecked="{Binding LoopbackCapture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Command="{Binding DataContext.RouteAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                         CommandParameter="{Binding}"
                                                         HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="20,14"
                            CornerRadius="10"
                            Background="#CC111827"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            Visibility="{Binding HasNoAudioSessions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Routing_NoSessions}"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="360" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    CornerRadius="12"
                    Background="#990B0F17"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource StudioSecondaryButtonStyle}"
                                Content="{DynamicResource Rules_ApplyAll}"
                                Command="{Binding ApplyAllRoutingRulesCommand}"
                                Margin="12,0,0,0" />
                        <TextBlock Text="{DynamicResource Rules_Title}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RoutingRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10,8"
                                            CornerRadius="8"
                                            Background="#CC111827"
                                            BorderBrush="#2A364D"
                                            BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource StudioDangerButtonStyle}"
                                                    MinHeight="28"
                                                    Padding="10,4"
                                                    FontSize="11.5"
                                                    Content="{DynamicResource Rules_Delete}"
                                                    Command="{Binding DataContext.DeleteRoutingRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="8,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                                                <TextBlock FontSize="11" Foreground="#94A3B8">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocKeyConverter}">
                                                            <Binding Path="ChannelNameKey" />
                                                            <Binding Path="Revision" Source="{x:Static services:LocalizationService.Instance}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
