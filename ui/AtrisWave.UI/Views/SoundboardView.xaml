<UserControl x:Class="AtrisWave.UI.Views.SoundboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:AtrisWave.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,12"
                CornerRadius="12"
                Background="#E60F1522"
                BorderBrush="#2A364D"
                BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource StudioDangerButtonStyle}"
                        Content="{DynamicResource Sb_StopAll}"
                        Command="{Binding StopAllSoundboardCommand}"
                        Margin="12,0,0,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Sb_Title}" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
                    <TextBlock Text="{DynamicResource Sb_Subtitle}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SoundboardPads}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5"
                                Padding="12"
                                CornerRadius="12"
                                Background="#CC0F172A"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Height="3"
                                        CornerRadius="2"
                                        Margin="0,0,0,8"
                                        Background="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}" />

                                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource StudioSecondaryButtonStyle}"
                                            MinHeight="28"
                                            Padding="10,4"
                                            FontSize="11"
                                            Margin="6,0,0,0"
                                            Content="{DynamicResource Sb_BrowseWav}"
                                            Command="{Binding DataContext.BrowseSoundboardWavCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="28"
                                             Padding="6,2"
                                             FontWeight="SemiBold"
                                             FontSize="12.5"
                                             Background="#141C2B"
                                             BorderBrush="#263248"
                                             VerticalAlignment="Center" />
                                </DockPanel>

                                <Grid Grid.Row="2" Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <controls:RotaryKnobControl Grid.Column="0"
                                                                 Value="{Binding Gain, Mode=TwoWay}"
                                                                 Minimum="0"
                                                                 Maximum="1.5"
                                                                 DefaultValue="1.0"
                                                                 Label="{DynamicResource Knob_Gain}"
                                                                 AccentColor="{Binding AccentColor}"
                                                                 Height="76" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding FileNameDisplay}"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,6" />
                                        <UniformGrid Rows="1" Columns="3">
                                            <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Ch_SendA1}" IsChecked="{Binding SendA1, Mode=TwoWay}" Height="22" Padding="2,0" FontSize="10" Margin="0,0,2,0" />
                                            <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Ch_SendB1}" IsChecked="{Binding SendB1, Mode=TwoWay}" Height="22" Padding="2,0" FontSize="10" Margin="1,0" />
                                            <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Ch_SendB2}" IsChecked="{Binding SendB2, Mode=TwoWay}" Height="22" Padding="2,0" FontSize="10" Margin="2,0,0,0" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>

                                <DockPanel Grid.Row="3">
                                    <ToggleButton DockPanel.Dock="Right"
                                                  Style="{StaticResource StudioToggleButtonStyle}"
                                                  Height="34"
                                                  Content="{DynamicResource Sb_Loop}"
                                                  IsChecked="{Binding Loop, Mode=TwoWay}"
                                                  Margin="6,0,0,0"
                                                  Padding="12,0" />
                                    <Button Style="{StaticResource StudioPrimaryButtonStyle}"
                                            Height="34"
                                            Content="{DynamicResource Sb_Play}"
                                            Command="{Binding DataContext.PlaySoundboardPadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasFile}"
                                            HorizontalAlignment="Stretch" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
