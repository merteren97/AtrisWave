<UserControl x:Class="AtrisWave.UI.Views.MicStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:AtrisWave.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Quick-Tune Bar: 5 Studio Voice Presets + Active Mic Badge + Listen/A-B/Pro + Live Mic Level -->
        <Border Grid.Row="0" Style="{StaticResource StudioCardStyle}" Margin="0,0,0,14">
            <StackPanel>
                <!-- Row 1: All 5 Presets on ONE balanced row -->
                <UniformGrid Rows="1" Columns="5" Margin="0,0,0,12">
                    <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="36" Content="{DynamicResource Mic_PresetRaw}" Command="{Binding ApplyMicVoicePresetCommand}" CommandParameter="RawClean" Margin="0,0,6,0" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource StudioPrimaryButtonStyle}" Height="36" Content="{DynamicResource Mic_PresetNatural}" Command="{Binding ApplyMicVoicePresetCommand}" CommandParameter="NaturalClear" Margin="0,0,6,0" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="36" Content="{DynamicResource Mic_PresetPodcast}" Command="{Binding ApplyMicVoicePresetCommand}" CommandParameter="PodcastRadio" Margin="0,0,6,0" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="36" Content="{DynamicResource Mic_PresetDiscord}" Command="{Binding ApplyMicVoicePresetCommand}" CommandParameter="DiscordGaming" Margin="0,0,6,0" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="36" Content="{DynamicResource Mic_PresetReverb}" Command="{Binding ApplyMicVoicePresetCommand}" CommandParameter="StudioReverb" HorizontalAlignment="Stretch" />
                </UniformGrid>

                <!-- Row 2: Active Mic Badge + Listen to Myself + Compare A/B + Pro Mode -->
                <DockPanel Margin="0,0,0,12">
                    <ui:ToggleSwitch DockPanel.Dock="Right"
                                     Content="{DynamicResource Mic_ProMode}"
                                     IsChecked="{Binding IsMicProMode, Mode=TwoWay}"
                                     VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,10,0"
                                Height="34"
                                Padding="11,0"
                                CornerRadius="8"
                                Background="#1638BDF8"
                                BorderBrush="#4438BDF8"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon_Mic}" Width="12" Height="12" Stretch="Uniform" Stroke="#38BDF8" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Mic_ActiveDeviceLabel}" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveMicDisplayName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ToggleButton Style="{StaticResource StudioToggleButtonStyle}"
                                      Height="34"
                                      IsChecked="{Binding MicDsp.DirectMonitor, Mode=TwoWay}"
                                      Margin="0,0,8,0"
                                      Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Headphones}" Width="14" Height="14" Stretch="Uniform" Stroke="#38BDF8" StrokeThickness="1.8" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Mic_ListenSelf}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource StudioToggleButtonStyle}"
                                      Height="34"
                                      IsChecked="{Binding MicDsp.BypassAll, Mode=TwoWay}"
                                      Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Compare}" Width="14" Height="14" Stretch="Uniform" Stroke="#F59E0B" StrokeThickness="1.8" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Mic_CompareAB}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>

                <!-- Row 3: Live Mic Level Bar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Mic_LiveLevel}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="1" Value="{Binding MicLiveLevelNormalized}" Foreground="#38BDF8" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- SIMPLE MODE (Default — Compact 2x2 Studio Cards + Live EQ/Spectrum Strip, Zero Wasted Voids) -->
        <Grid Grid.Row="1" Visibility="{Binding IsMicProMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card 1: Noise Cleanup -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StudioCardStyle}" Padding="15,13">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Mic_NoiseCleanup}" FontSize="14.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,10" />
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
                            <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="32" Padding="6,0" Content="{DynamicResource Mic_NoiseOff}" Command="{Binding SetDenoiseLevelCommand}" CommandParameter="Off" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                            <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="32" Padding="6,0" Content="{DynamicResource Mic_NoiseLight}" Command="{Binding SetDenoiseLevelCommand}" CommandParameter="Light" Margin="2,0" HorizontalAlignment="Stretch" />
                            <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="32" Padding="6,0" Content="{DynamicResource Mic_NoiseMedium}" Command="{Binding SetDenoiseLevelCommand}" CommandParameter="Medium" Margin="2,0" HorizontalAlignment="Stretch" />
                            <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="32" Padding="6,0" Content="{DynamicResource Mic_NoiseStrong}" Command="{Binding SetDenoiseLevelCommand}" CommandParameter="Strong" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
                        </UniformGrid>
                        <DockPanel>
                            <controls:RotaryKnobControl DockPanel.Dock="Right" Value="{Binding MicDsp.GateThresholdDb, Mode=TwoWay}" Minimum="-80" Maximum="-10" DefaultValue="-45" Unit="dB" Label="{DynamicResource Knob_Gate}" AccentColor="#10B981" Height="78" Width="76" Margin="10,0,0,0" />
                            <StackPanel VerticalAlignment="Center">
                                <ui:ToggleSwitch Content="{DynamicResource Dsp_NoiseGate_Name}" IsChecked="{Binding MicDsp.GateEnabled, Mode=TwoWay}" Margin="0,0,0,4" />
                                <TextBlock Text="{DynamicResource Dsp_NoiseGate_Desc}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Voice Tone -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource StudioCardStyle}" Padding="15,13">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <ui:ToggleSwitch DockPanel.Dock="Right" Content="{DynamicResource Mic_RumbleFilter}" IsChecked="{Binding MicDsp.EqEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Mic_VoiceTone}" FontSize="14.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </DockPanel>
                        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center">
                            <controls:RotaryKnobControl Value="{Binding MicDsp.EqLowDb, Mode=TwoWay}" Minimum="-12" Maximum="12" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqLow}" AccentColor="#A855F7" Height="88" />
                            <controls:RotaryKnobControl Value="{Binding MicDsp.EqMid1Db, Mode=TwoWay}" Minimum="-12" Maximum="12" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqMid}" AccentColor="#A855F7" Height="88" />
                            <controls:RotaryKnobControl Value="{Binding MicDsp.EqMid2Db, Mode=TwoWay}" Minimum="-12" Maximum="12" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqHigh}" AccentColor="#38BDF8" Height="88" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Card 3: Volume Balance -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource StudioCardStyle}" Padding="15,13">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.CompEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Mic_VolumeBalance}" FontSize="14.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </DockPanel>
                        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center" Margin="0,0,0,8">
                            <controls:RotaryKnobControl Value="{Binding MicDsp.CompThresholdDb, Mode=TwoWay}" Minimum="-45" Maximum="0" DefaultValue="-20" Unit="dB" Label="{DynamicResource Drawer_CompShort}" AccentColor="#F59E0B" Height="82" />
                            <controls:RotaryKnobControl Value="{Binding MicDsp.CompRatio, Mode=TwoWay}" Minimum="1" Maximum="8" DefaultValue="2.5" Label="{DynamicResource Knob_Ratio}" AccentColor="#F59E0B" Height="82" />
                            <controls:RotaryKnobControl Value="{Binding MicDsp.MonitorGain, Mode=TwoWay}" Minimum="0" Maximum="1.5" DefaultValue="1.0" Label="{DynamicResource Knob_Monitor}" AccentColor="#38BDF8" Height="82" />
                        </UniformGrid>
                        <Border Grid.Row="2" Padding="10,6" CornerRadius="8" Background="#141C2B" BorderBrush="#263248" BorderThickness="1">
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.LimiterEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Dsp_Limiter_Name}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 4: Voice Effects (Full-Width Pitch Row, Zero Clipping) -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource StudioCardStyle}" Padding="15,13">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MicDsp.ReverbEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Mic_VoiceEffects}" FontSize="14.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                <TextBlock Text=" · " Foreground="#64748B" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Dsp_Reverb_Name}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <ComboBox SelectedIndex="{Binding MicDsp.ReverbMode, Mode=TwoWay}" Margin="0,0,0,10">
                            <ComboBoxItem Content="{DynamicResource Dsp_ReverbMode_Algo}" />
                            <ComboBoxItem Content="{DynamicResource Dsp_ReverbMode_Studio}" />
                            <ComboBoxItem Content="{DynamicResource Dsp_ReverbMode_Broadcast}" />
                            <ComboBoxItem Content="{DynamicResource Dsp_ReverbMode_Concert}" />
                        </ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.25*" />
                            </Grid.ColumnDefinitions>
                            <controls:RotaryKnobControl Grid.Column="0" Value="{Binding MicDsp.ReverbWet, Mode=TwoWay}" Minimum="0" Maximum="1" DefaultValue="0.15" Label="{DynamicResource Knob_Reverb}" AccentColor="#38BDF8" Height="82" />
                            <controls:RotaryKnobControl Grid.Column="1" Value="{Binding MicDsp.PitchSemitones, Mode=TwoWay}" Minimum="-12" Maximum="12" DefaultValue="0" Unit="st" Label="{DynamicResource Knob_Pitch}" AccentColor="#A855F7" Height="82" />
                            <Border Grid.Column="2" Margin="6,0,0,0" Padding="10,8" CornerRadius="8" Background="#141C2B" BorderBrush="#263248" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Dsp_PitchTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <ui:ToggleSwitch IsChecked="{Binding MicDsp.PitchEnabled, Mode=TwoWay}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live Interactive EQ Curve & Real-Time 32-Band Spectrum Visualizer Strip -->
            <Border Grid.Row="1" Style="{StaticResource StudioCardStyle}" Padding="12,10" MinHeight="120">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Dsp_EqCurveTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="4,0,0,6" />
                    <controls:EqCurveControl Grid.Row="1" x:Name="SimpleEqCurve" Settings="{Binding MicDsp}" SpectrumDb="{Binding SpectrumDb}" />
                </Grid>
            </Border>
        </Grid>

        <!-- PRO STUDIO MODE (Full 32-Band FFT EqCurveControl + Module Toggles + All Knobs + AutoEq + Presets) -->
        <Grid Grid.Row="1" Visibility="{Binding IsMicProMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource StudioCardStyle}" Margin="0,0,0,10" Padding="14,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="36" Content="{DynamicResource Dsp_ImportAutoEq}" Command="{Binding ImportAutoEqCommand}" Margin="0,0,10,0" />
                        <ComboBox Width="170" Height="36" IsEditable="True" ItemsSource="{Binding Presets}" Text="{Binding PresetNameInput, Mode=TwoWay}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource StudioSecondaryButtonStyle}" Height="36" Content="{DynamicResource Dsp_SavePreset}" Command="{Binding SavePresetCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource StudioPrimaryButtonStyle}" Height="36" Content="{DynamicResource Dsp_LoadPreset}" Command="{Binding LoadPresetCommand}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Dsp_EqCurveTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource StudioCardStyle}" Margin="0,0,0,10" Padding="6">
                <controls:EqCurveControl x:Name="EqCurve" Settings="{Binding MicDsp}" SpectrumDb="{Binding SpectrumDb}" />
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource StudioCardStyle}" Margin="0,0,7,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Knob_Denoise}" IsChecked="{Binding MicDsp.DenoiseEnabled, Mode=TwoWay}" FontSize="10" Padding="8,3" Margin="0,0,6,4" />
                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Knob_Gate}" IsChecked="{Binding MicDsp.GateEnabled, Mode=TwoWay}" FontSize="10" Padding="8,3" Margin="0,0,6,4" />
                            </WrapPanel>
                            <UniformGrid Columns="3">
                                <controls:RotaryKnobControl Value="{Binding MicDsp.MonitorGain, Mode=TwoWay}" Minimum="0" Maximum="1.5" DefaultValue="1.0" Label="{DynamicResource Knob_Monitor}" AccentColor="#38BDF8" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.DenoiseStrength, Mode=TwoWay}" Minimum="0" Maximum="1" DefaultValue="0.25" Label="{DynamicResource Knob_Denoise}" AccentColor="#06B6D4" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.GateThresholdDb, Mode=TwoWay}" Minimum="-80" Maximum="-10" DefaultValue="-45" Unit="dB" Label="{DynamicResource Knob_Gate}" AccentColor="#10B981" Height="82" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioCardStyle}" Margin="4,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Dsp_ParametricEq_Name}" IsChecked="{Binding MicDsp.EqEnabled, Mode=TwoWay}" FontSize="10" Padding="8,3" Margin="0,0,6,4" />
                            </WrapPanel>
                            <UniformGrid Columns="3">
                                <controls:RotaryKnobControl Value="{Binding MicDsp.EqHpfHz, Mode=TwoWay}" Minimum="20" Maximum="300" DefaultValue="75" Unit="Hz" Label="{DynamicResource Knob_Hpf}" AccentColor="#38BDF8" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.EqLowDb, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqLow}" AccentColor="#A855F7" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.EqMid1Db, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Knob_Mid1}" AccentColor="#A855F7" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.EqMid2Db, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Knob_Mid2}" AccentColor="#A855F7" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.EqHighDb, Mode=TwoWay}" Minimum="-15" Maximum="15" DefaultValue="0" Unit="dB" Label="{DynamicResource Drawer_EqHigh}" AccentColor="#A855F7" Height="82" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StudioCardStyle}" Margin="7,0,0,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Drawer_CompShort}" IsChecked="{Binding MicDsp.CompEnabled, Mode=TwoWay}" FontSize="10" Padding="8,3" Margin="0,0,4,4" />
                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Knob_Duck}" IsChecked="{Binding MicDsp.DuckingEnabled, Mode=TwoWay}" FontSize="10" Padding="8,3" Margin="0,0,4,4" />
                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Knob_Reverb}" IsChecked="{Binding MicDsp.ReverbEnabled, Mode=TwoWay}" FontSize="10" Padding="8,3" Margin="0,0,4,4" />
                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Knob_Pitch}" IsChecked="{Binding MicDsp.PitchEnabled, Mode=TwoWay}" FontSize="10" Padding="8,3" Margin="0,0,4,4" />
                                <ToggleButton Style="{StaticResource StudioToggleButtonStyle}" Content="{DynamicResource Knob_Limit}" IsChecked="{Binding MicDsp.LimiterEnabled, Mode=TwoWay}" FontSize="10" Padding="8,3" Margin="0,0,0,4" />
                            </WrapPanel>
                            <UniformGrid Columns="3">
                                <controls:RotaryKnobControl Value="{Binding MicDsp.CompThresholdDb, Mode=TwoWay}" Minimum="-45" Maximum="0" DefaultValue="-20" Unit="dB" Label="{DynamicResource Knob_Thresh}" AccentColor="#F59E0B" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.CompRatio, Mode=TwoWay}" Minimum="1" Maximum="12" DefaultValue="2.5" Label="{DynamicResource Knob_Ratio}" AccentColor="#F59E0B" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.DuckingDepthDb, Mode=TwoWay}" Minimum="-30" Maximum="0" DefaultValue="-12" Unit="dB" Label="{DynamicResource Knob_Duck}" AccentColor="#EC4899" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.ReverbWet, Mode=TwoWay}" Minimum="0" Maximum="1" DefaultValue="0.15" Label="{DynamicResource Knob_Reverb}" AccentColor="#38BDF8" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.PitchSemitones, Mode=TwoWay}" Minimum="-12" Maximum="12" DefaultValue="0" Unit="st" Label="{DynamicResource Knob_Pitch}" AccentColor="#A855F7" Height="82" />
                                <controls:RotaryKnobControl Value="{Binding MicDsp.LimiterCeilingDb, Mode=TwoWay}" Minimum="-6" Maximum="0" DefaultValue="-0.5" Unit="dB" Label="{DynamicResource Knob_Limit}" AccentColor="#EF4444" Height="82" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
